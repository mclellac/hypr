# Theme: Green Monster
# By: Gemini

# Main bg
theme[main_bg]="#05100D"

# Main text color
theme[main_fg]="#D0F4EA"

# Title color for boxes
theme[title]="#00D998"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#00FF9F"

# Background color of selected item in processes box
theme[selected_bg]="#1F4D43"

# Foreground color of selected item in processes box
theme[selected_fg]="#D0F4EA"

# Color of inactive/disabled text
theme[inactive_fg]="#2A3834"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#00D998"

# Cpu box outline color
theme[cpu_box]="#E9FF70"

# Memory/disks box outline color
theme[mem_box]="#7CFFCB"

# Net up/down box outline color
theme[net_box]="#00FF9F"

# Processes box outline color
theme[proc_box]="#00D998"

# Box divider line and small boxes line color
theme[div_line]="#141B19"

# Temperature graph colors
theme[temp_start]="#7CFFCB"
theme[temp_mid]="#E9FF70"
theme[temp_end]="#FF5C5C"

# CPU graph colors
theme[cpu_start]="#00D998"
theme[cpu_mid]="#E9FF70"
theme[cpu_end]="#FF5C5C"

# Mem/Disk free meter
theme[free_start]="#00FF9F"
theme[free_mid]="#7CFFCB"
theme[free_end]="#D0F4EA"

# Mem/Disk cached meter
theme[cached_start]="#1F4D43"
theme[cached_mid]="#00D998"
theme[cached_end]="#7CFFCB"

# Mem/Disk available meter
theme[available_start]="#00FF9F"
theme[available_mid]="#7CFFCB"
theme[available_end]="#D0F4EA"

# Mem/Disk used meter
theme[used_start]="#E9FF70"
theme[used_mid]="#FF5C5C"
theme[used_end]="#FF4B4B"

# Download graph colors
theme[download_start]="#00D998"
theme[download_mid]="#7CFFCB"
theme[download_end]="#1F4D43"

# Upload graph colors
theme[upload_start]="#00FF9F"
theme[upload_mid]="#7CFFCB"
theme[upload_end]="#D0F4EA"
