# btop theme for Amateur theme
# Colors should match the palette.md and theme.yaml

# Main background, empty for terminal default, black for 24-bit test
theme[main_bg]="#343F50"

# Main text color
theme[main_fg]="#CEE2E4"

# Title color for boxes
theme[title]="#33ffdd"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#FFB86C"

# Background color of selected item in processes box
theme[selected_bg]="#00A8A8"

# Foreground color of selected item in processes box
theme[selected_fg]="#CEE2E4"

# Color of inactive/disabled text
theme[inactive_fg]="#4D5566"

# Color of graph points
theme[graph_text]="#59C2FF"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#59C2FF"

# Cpu box outline color
theme[cpu_box]="#33ffdd"

# Memory box outline color
theme[mem_box]="#59C2FF"

# Net box outline color
theme[net_box]="#e393f6"

# Processes box outline color
theme[proc_box]="#33ffdd"

# Box divider line and small boxes line color
theme[div_line]="#445163"

# Temperature graph colors
theme[temp_start]="#33ffdd"
theme[temp_mid]="#FFB86C"
theme[temp_end]="#FF5722"

# CPU graph colors
theme[cpu_start]="#33ffdd"
theme[cpu_mid]="#59C2FF"
theme[cpu_end]="#e393f6"

# Mem graph colors
theme[mem_start]="#59C2FF"
theme[mem_mid]="#e393f6"
theme[mem_end]="#FFB86C"

# Net graph colors
theme[net_start]="#e393f6"
theme[net_mid]="#33ffdd"
theme[net_end]="#59C2FF"

# Processes graph colors
theme[proc_start]="#33ffdd"
theme[proc_mid]="#59C2FF"
theme[proc_end]="#e393f6"
