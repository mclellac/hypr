# Theme: Zen Paper Strict
# Created by: Hyprland Config Manager
# Verified palette: #e6e4da, #2e2e2e, #f76f53

# Main background
theme[main_bg]="#e6e4da"

# Main text color
theme[main_fg]="#2e2e2e"

# Title color for boxes
theme[title]="#2e2e2e"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f76f53"

# Background color of selected item in processes box
theme[selected_bg]="#f76f53"

# Foreground color of selected item in processes box
theme[selected_fg]="#e6e4da"

# Color of inactive/disabled text
theme[inactive_fg]="#2e2e2e"

# Color of text appearing on top of graphs, i.e. uptime and current network download/upload
theme[graph_text]="#2e2e2e"

# Background color of the percentage meters
theme[meter_bg]="#e6e4da"

# Misc colors for processes box including mini cpu graphs, memory size and process tree lines
theme[proc_misc]="#f76f53"

# Cpu box outline color
theme[cpu_box]="#f76f53"

# Memory box outline color
theme[mem_box]="#f76f53"

# Net box outline color
theme[net_box]="#f76f53"

# Processes box outline color
theme[proc_box]="#f76f53"

# Box divider line and small boxes line color
theme[div_line]="#f76f53"

# Temperature graph colors
theme[temp_start]="#f76f53"
theme[temp_mid]="#f76f53"
theme[temp_end]="#f76f53"

# CPU graph colors
theme[cpu_start]="#f76f53"
theme[cpu_mid]="#f76f53"
theme[cpu_end]="#f76f53"

# Mem graph colors
theme[mem_start]="#f76f53"
theme[mem_mid]="#f76f53"
theme[mem_end]="#f76f53"

# Net graph colors
theme[net_start]="#f76f53"
theme[net_mid]="#f76f53"
theme[net_end]="#f76f53"

# Processes graph colors
theme[proc_start]="#f76f53"
theme[proc_mid]="#f76f53"
theme[proc_end]="#f76f53"

# Download graph colors
theme[download_start]="#f76f53"
theme[download_mid]="#f76f53"
theme[download_end]="#f76f53"

# Upload graph colors
theme[upload_start]="#f76f53"
theme[upload_mid]="#f76f53"
theme[upload_end]="#f76f53"

# Process battery color
theme[process_battery]="#f76f53"
