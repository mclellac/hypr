#Btop monokai pro ristretto theme
#Reconfigured from monokai theme

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#252020"

# Main text color
theme[main_fg]="#eee0d7"

# Title color for boxes
theme[title]="#eee0d7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e06c75"

# Background color of selected item in processes box
theme[selected_bg]="#443634"

# Foreground color of selected item in processes box
theme[selected_fg]="#f5ece5"

# Color of inactive/disabled text
theme[inactive_fg]="#4c3f3e"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#98c379"

# Cpu box outline color
theme[cpu_box]="#4c3f3e"

# Memory/disks box outline color
theme[mem_box]="#4c3f3e"

# Net up/down box outline color
theme[net_box]="#4c3f3e"

# Processes box outline color
theme[proc_box]="#4c3f3e"

# Box divider line and small boxes line color
theme[div_line]="#7c6c6b"

# Temperature graph colors
theme[temp_start]="#c694c8"
theme[temp_mid]="#ffaa3b"
theme[temp_end]="#e06c75"

# CPU graph colors
theme[cpu_start]="#98c379"
theme[cpu_mid]="#f7c244"
theme[cpu_end]="#e06c75"

# Mem/Disk free meter
theme[free_start]="#4c3f3e"
theme[free_mid]="#98c379"
theme[free_end]="#add88d"

# Mem/Disk cached meter
theme[cached_start]="#4c3f3e"
theme[cached_mid]="#75c4b6"
theme[cached_end]="#8cd5c8"

# Mem/Disk available meter
theme[available_start]="#4c3f3e"
theme[available_mid]="#f7c244"
theme[available_end]="#f9ce6b"

# Mem/Disk used meter
theme[used_start]="#4c3f3e"
theme[used_mid]="#e06c75"
theme[used_end]="#eb838b"

# Download graph colors
theme[download_start]="#332928"
theme[download_mid]="#c694c8"
theme[download_end]="#d4a4d6"

# Upload graph colors
theme[upload_start]="#332928"
theme[upload_mid]="#e06c75"
theme[upload_end]="#eb838b"

