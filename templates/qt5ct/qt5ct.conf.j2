[Appearance]
custom_palette=false
icon_theme={{ theme.gtk.icon_theme | default('Adwaita') }}
standard_dialogs=default
style={{ theme.gtk.qt_theme | default('kvantum') }}

[Interface]
double_click_interval=400
cursor_blink_rate=1200
buttonbox_layout=0
keyboard_scheme=2
show_icons_in_menus=true
show_icons_on_buttons=true
wheel_scroll_lines=3

[Troubleshooting]
force_raster_widgets=false
ignored_applications=@Invalid()
