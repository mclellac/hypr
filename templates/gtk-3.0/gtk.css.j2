/* GTK 3.0 Theme Configuration */

{% set accent_choice = theme.gtk.accent_color | default('blue') -%}
{% if accent_choice == 'teal' or accent_choice == 'cyan' -%}
  {% set gtk_accent = theme.colors.primary | default(theme.colors.color6) | default(theme.colors.color14) | default(theme.colors.accent) -%}
{% elif accent_choice == 'blue' -%}
  {% set gtk_accent = theme.colors.color4 | default(theme.colors.color12) | default(theme.colors.accent) | default(theme.colors.primary) -%}
{% elif accent_choice == 'green' -%}
  {% set gtk_accent = theme.colors.color2 | default(theme.colors.color10) | default(theme.colors.success) | default(theme.colors.accent) -%}
{% elif accent_choice == 'yellow' -%}
  {% set gtk_accent = theme.colors.color3 | default(theme.colors.color11) | default(theme.colors.accent) | default(theme.colors.warning) -%}
{% elif accent_choice == 'orange' -%}
  {% set gtk_accent = theme.colors.accent | default(theme.colors.color12) | default(theme.colors.color4) | default(theme.colors.warning) | default('#ffaa00') -%}
{% elif accent_choice == 'red' -%}
  {% set gtk_accent = theme.colors.color1 | default(theme.colors.color9) | default(theme.colors.alert) | default(theme.colors.accent) -%}
{% elif accent_choice == 'pink' or accent_choice == 'purple' -%}
  {% set gtk_accent = theme.colors.color5 | default(theme.colors.color13) | default(theme.colors.accent) | default('#ff00ff') -%}
{% else -%}
  {% set gtk_accent = theme.colors.accent | default(theme.colors.primary) -%}
{% endif -%}

/* Standard Theme Variables */
@define-color theme_bg_color {{ theme.colors.background }};
@define-color theme_fg_color {{ theme.colors.foreground }};
@define-color theme_base_color {{ theme.colors.background }};
@define-color theme_text_color {{ theme.colors.foreground }};
@define-color theme_selected_bg_color {{ theme.colors.selection_bg | default(gtk_accent) }};
@define-color theme_selected_fg_color {{ theme.colors.selection_bg | default(gtk_accent) | hypr_contrast_fg(theme.colors.selection_fg | default('#121212'), theme.colors.selection_fg | default('#ffffff')) }};
@define-color theme_border_color {{ theme.colors.background | hypr_mix_color(theme.colors.foreground, 0.15) }};

@define-color bg_color {{ theme.colors.background }};
@define-color fg_color {{ theme.colors.foreground }};
@define-color base_color {{ theme.colors.background }};
@define-color text_color {{ theme.colors.foreground }};
@define-color selected_bg_color {{ theme.colors.selection_bg | default(gtk_accent) }};
@define-color selected_fg_color {{ theme.colors.selection_bg | default(gtk_accent) | hypr_contrast_fg(theme.colors.selection_fg | default('#121212'), theme.colors.selection_fg | default('#ffffff')) }};
@define-color border_color {{ theme.colors.background | hypr_mix_color(theme.colors.foreground, 0.15) }};

/* Elements definitions */
@define-color sidebar_bg_color {{ theme.colors.background | hypr_mix_color(theme.colors.foreground, 0.04) }};
@define-color sidebar_fg_color {{ theme.colors.foreground }};
@define-color sidebar_border_color {{ theme.colors.background | hypr_mix_color(theme.colors.foreground, 0.12) }};
@define-color card_bg_color {{ theme.colors.background | hypr_mix_color(theme.colors.foreground, 0.03) }};
@define-color card_fg_color {{ theme.colors.foreground }};
@define-color card_border_color {{ theme.colors.background | hypr_mix_color(theme.colors.foreground, 0.12) }};
@define-color entry_bg_color {{ theme.colors.background | hypr_mix_color(theme.colors.foreground, 0.03) }};
@define-color entry_fg_color {{ theme.colors.foreground }};
@define-color entry_border_color {{ theme.colors.background | hypr_mix_color(theme.colors.foreground, 0.12) }};

@define-color success_color {{ theme.colors.success | default('#2ecc71') }};
@define-color success_fg_color {{ theme.colors.success | default('#2ecc71') | hypr_contrast_fg }};
@define-color warning_color {{ theme.colors.warning | default('#f1c40f') }};
@define-color warning_fg_color {{ theme.colors.warning | default('#f1c40f') | hypr_contrast_fg }};
@define-color error_color {{ theme.colors.alert | default('#e74c3c') }};
@define-color error_fg_color {{ theme.colors.alert | default('#e74c3c') | hypr_contrast_fg }};

/* General widget styling overrides for maximum cohesion */

/* Window & View backgrounds */
window,
.background {
  background-color: @theme_bg_color;
  color: @theme_fg_color;
}

/* Base text view / input fields */
view,
textview,
textview text {
  background-color: @theme_base_color;
  color: @theme_text_color;
}

/* Text entry fields */
entry {
  background-color: @entry_bg_color;
  color: @theme_text_color;
  border: 1px solid @entry_border_color;
  border-radius: {{ theme.layout.rounding | default(4) }}px;
}

/* Headerbar / Titlebar overrides */
headerbar,
.titlebar,
.header-bar {
  background-color: @theme_bg_color;
  color: @theme_fg_color;
  border-bottom: 1px solid @theme_border_color;
  box-shadow: none;
}

/* Sidebar background color overrides */
.sidebar,
stacksidebar,
listbox.sidebar {
  background-color: @sidebar_bg_color;
  color: @theme_fg_color;
  border-right: 1px solid @sidebar_border_color;
}

/* Cards / Frame borders */
.card,
frame,
.frame {
  background-color: @card_bg_color;
  border: 1px solid @card_border_color;
  border-radius: {{ theme.layout.rounding | default(4) }}px;
}

/* Scrollbars slider customization */
scrollbar,
scrollbar.slider,
scrollbar slider {
  background-color: transparent;
  background: transparent;
  border: none;
}

scrollbar slider {
  background-color: @theme_selected_bg_color;
  border-radius: {{ theme.layout.rounding | default(4) }}px;
  min-width: 6px;
  min-height: 6px;
}

scrollbar slider:hover {
  background-color: @theme_selected_bg_color;
}

/* Popover / Wayland background fix */
popover,
.popover {
  background-color: transparent;
  background: transparent;
  box-shadow: none;
  border: none;
}

popovercontents,
popover > contents,
.popover > contents,
menu,
.menu,
.popup-menu {
  box-shadow: none;
  border: 1px solid @theme_border_color;
  border-radius: {{ theme.layout.rounding | default(4) }}px;
  background-color: @sidebar_bg_color;
  color: @theme_fg_color;
}

/* Toolbar */
toolbar {
  background-color: @sidebar_bg_color;
  color: @theme_fg_color;
  border-bottom: 1px solid @theme_border_color;
}
