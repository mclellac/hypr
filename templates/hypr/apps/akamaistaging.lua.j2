-- --- Akamai Staging ---
hl.window_rule({
    name = "akamaistaging-float",
    match = {
        class = [=[^(?i).*(akamaistaging).*$]=]
    },
    float = true,
    center = true,
    size = { 1100, 700 }
})

hl.window_rule({
    name = "akamaistaging-title-float",
    match = {
        title = [=[^(?i).*(akamaistaging).*$]=]
    },
    float = true,
    center = true,
    size = { 1100, 700 }
})
