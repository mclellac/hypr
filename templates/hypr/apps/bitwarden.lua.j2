-- --- Bitwarden App ---
hl.window_rule({
    name = "bitwarden-global",
    match = {
        class = "^(Bitwarden)$"
    },
    no_screen_share = true,
    tag = "+floating-window"
})


-- --- Bitwarden Chrome Extension ---
hl.window_rule({
    name = "bitwarden-extension",
    match = {
        class = "chrome-nngceckbapebfimnlniiiahkandclblb-Default"
    },
    no_screen_share = true,
    tag = "+floating-window"
})

