-- Autostart
hl.on("hyprland.start", function()
    -- Environment synchronization
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
    hl.exec_cmd("systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")

    -- Services
    hl.exec_cmd("pkill mako || true")
    hl.exec_cmd("uwsm app -- mako")
    hl.exec_cmd("uwsm app -- waybar")
    hl.exec_cmd("uwsm app -- swaybg -i ~/.config/hypr/current_background -m fill")
    hl.exec_cmd("uwsm app -- swayosd-server")
    hl.exec_cmd("uwsm app -- /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1")
    hl.exec_cmd("uwsm app -- hypr-cmd-first-run")


    -- Clipboard backend (cliphist)
    hl.exec_cmd("uwsm app -- wl-paste --type text --watch cliphist store")
    hl.exec_cmd("uwsm app -- wl-paste --type image --watch cliphist store")

    -- Clipboard frontend (walker)
    hl.exec_cmd("uwsm app -- {{ bin('hypr-notification-logger') }}")

{%- if theme.input.solaar_enabled | default(true) %}
    -- Solaar
    hl.exec_cmd("uwsm app -- solaar --window=hide")
{%- endif %}
end)
