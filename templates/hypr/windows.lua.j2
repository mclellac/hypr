{% endif %}

-- Workspace 6: Notes (SEC/NOTES)
{% if theme.hypr.window.workspace_assignment.notes | default(true) %}
hl.window_rule({
    name = "tag-notes",
    match = { class = [=[^(?i).*(obsidian|Notion|notion|Logseq|logseq|Simplenote|simplenote|Standard Notes|standard-notes|Joplin|joplin|CherryTree|cherrytree|Zettlr|zettlr|Anytype|anytype).*$]=] },
    tag = "+notes"
})

hl.window_rule({
    name = "workspace-notes",
    match = { tag = "notes" },
    workspace = "6",
    animation = [=[{{ theme.hypr.window.animation.notes | default('slide') }}]=]
})
{% endif %}

-- --- Default Window Sizes ---
hl.window_rule({
    name = "size-floating",
    match = { class = ".*", initial_title = [=[^(Floating.*)$]=] },
    size = { {{ theme.hypr.window.size.floating | default('1200 800') | replace(' ', ', ') }} }
})

hl.window_rule({
    name = "size-dialog",
    match = { class = ".*", initial_title = [=[^(Dialog.*|Select.*|Open.*|Save.*)$]=] },
    size = { {{ theme.hypr.window.size.dialog | default('900 600') | replace(' ', ', ') }} }
})

hl.window_rule({
    name = "size-editor",
    match = { class = ".*", initial_title = [=[^(Editor.*)$]=] },
    size = { {{ theme.hypr.window.size.editor | default('1000 700') | replace(' ', ', ') }} }
})

hl.window_rule({
    name = "size-creator",
    match = { class = ".*", initial_title = [=[^(Creator.*)$]=] },
    size = { {{ theme.hypr.window.size.creator | default('1100 700') | replace(' ', ', ') }} }
})
