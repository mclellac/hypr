-- --- Compatibility Shims for Legacy hyprctl calls ---

-- Shim for keyword command emulation via hl.config
function _G.keyword(name, value)
    if not name then return end
    
    -- Handle special keywords that have direct hl functions
    if name == "monitor" then
        return hl.monitor(value)
    elseif name == "workspace" then
        -- Convert "1, layout:master" to table
        local id, opt = value:match("^([^,]+)%s*,%s*(.+)$")
        if id and opt then
            -- Note: For generic fallback, we'd need to parse `opt` properly. 
            -- But since `layout:` is common, let's parse it specifically if possible.
            local key, val = opt:match("^(%w+):(.+)$")
            if key and val then
                return hl.workspace_rule({ workspace = id, [key] = val })
            end
        end
        return -- unable to shim cleanly
    elseif name == "windowrule" or name == "windowrulev2" then
        -- This is a simplistic shim, real windowrulev2 parsing is complex.
        -- Just ignore or rely on native hl.window_rule calls instead.
        return
    end

    -- Handle dotted/colon-separated config paths
    local parts = {}
    for part in name:gmatch("([^:%s%.]+)") do
        table.insert(parts, part)
    end
    
    if #parts == 0 then return end

    local cfg = {}
    local curr = cfg
    for i=1, #parts-1 do
        curr[parts[i]] = {}
        curr = curr[parts[i]]
    end
    
    -- Handle value types (bool, number, string)
    local val = value
    if value == "true" or value == "1" or value == "on" then val = true
    elseif value == "false" or value == "0" or value == "off" then val = false
    elseif tonumber(value) then val = tonumber(value)
    end
    
    curr[parts[#parts]] = val
    hl.config(cfg)
end

-- --- Safe modular loading helper ---
local function safe_require(module_name)
    package.loaded[module_name] = nil
    local success, err = pcall(require, module_name)
    if not success then
        -- Only print error if it's NOT a "module not found" error
        if not string.find(err, "module '" .. module_name .. "' not found") then
            print("Error loading module: " .. module_name .. " - " .. tostring(err))
        end
    end
end

