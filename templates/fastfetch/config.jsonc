{% from "partials/colors.j2" import get_color %}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/hypr/branding/about.txt",
    "color": { "1": "{{ get_color('primary', 'green') | hypr_color  }}" },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "{{ get_color('primary', 'green') | hypr_color  }}"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "{{ get_color('primary', 'green') | hypr_color  }}"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "keyColor": "{{ get_color('primary', 'green') | hypr_color  }}"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "{{ get_color('primary', 'green') | hypr_color  }}"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "{{ get_color('primary', 'green') | hypr_color  }}"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "{{ get_color('primary', 'green') | hypr_color  }}"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "{{ get_color('primary', 'green') | hypr_color  }}"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\ue900 OS",
      "keyColor": "{{ get_color('secondary', 'blue') | hypr_color  }}",
      "text": "version=$(hypr-version); echo \"hypr $version\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "{{ get_color('secondary', 'blue') | hypr_color  }}",
      "text": "branch=$(hypr-version-branch); echo \"$branch\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "{{ get_color('secondary', 'blue') | hypr_color  }}"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "{{ get_color('secondary', 'blue') | hypr_color  }}"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "{{ get_color('secondary', 'blue') | hypr_color  }}"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "{{ get_color('secondary', 'blue') | hypr_color  }}"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "{{ get_color('secondary', 'blue') | hypr_color  }}"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "{{ get_color('secondary', 'blue') | hypr_color  }}"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "{{ get_color('secondary', 'blue') | hypr_color  }}",
      "text": "theme=$(hypr-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "{{ get_color('secondary', 'blue') | hypr_color  }}"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────Uptime / Age────────────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "{{ get_color('color13', 'magenta') | hypr_color  }}",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "{{ get_color('color13', 'magenta') | hypr_color  }}"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
