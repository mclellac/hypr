{% from "partials/colors.j2" import get_color %}
{% from "partials/fonts.j2" import font_family, font_size, font_style %}
font={{ font_family() }} {{ font_size(theme.mako.font_size, 10) }}

# Global spacing
margin={{ theme.mako.margin | default(20) }}
padding={{ theme.mako.padding | default(15) }}

border-radius={{ theme.layout.rounding | default(5) }}
border-size={{ theme.layout.border_size }}
group-by=app-name
format=<b>%a</b>\n%s\n%b
actions=1

background-color={{ get_color('background') | hypr_color | default("#222222")  }}
text-color={{ get_color('foreground') | hypr_color | default("#ffffff")  }}
border-color={{ theme.layout.active_border | hypr_color | default("#33ccff") }}
default-timeout={{ theme.mako.timeout | default(5000) }}
ignore-timeout=1

[urgency=low]
background-color={{ get_color('background') | hypr_color | default("#222222")  }}
text-color={{ get_color('foreground') | hypr_color | default("#ffffff")  }}
border-color={{ theme.layout.active_border | hypr_color | default("#33ccff") }}
default-timeout={{ theme.mako.timeout | default(8000) }}

[urgency=normal]
background-color={{ get_color('background') | hypr_color | default("#222222")  }}
text-color={{ get_color('foreground') | hypr_color | default("#ffffff")  }}
border-color={{ theme.layout.active_border | hypr_color | default("#33ccff") }}
default-timeout={{ theme.mako.timeout | default(5000) }}

[urgency=critical]
background-color={{ get_color('background') | hypr_color | default("#222222")  }}
text-color={{ get_color('foreground') | hypr_color | default("#ffffff")  }}
border-color={{ get_color('alert') | hypr_color | default("#ff0000")  }}
default-timeout=5000

progress-color={{ get_color('primary') | hypr_color | default("#33ccff")  }}
