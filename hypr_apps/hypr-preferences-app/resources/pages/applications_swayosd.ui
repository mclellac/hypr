<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="page_content"><property name="orientation">vertical</property><property name="spacing">12</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title">SwayOSD</property>
        <property name="description">On-screen display for volume and brightness</property>
        <child>
          <object class="AdwSpinRow" id="swayosd_font_size">
            <property name="title">Font Size</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="lower">8</property>
                <property name="upper">72</property>
                <property name="step-increment">1</property>
                <property name="value">14</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
