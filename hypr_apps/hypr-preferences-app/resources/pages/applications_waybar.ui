<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="page_content"><property name="orientation">vertical</property><property name="spacing">12</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title">Waybar Configuration</property>
        <child>
          <object class="AdwComboRow" id="waybar_position">
            <property name="title">Position</property>
            <property name="subtitle">Bar position on screen</property>
            <property name="model">
              <object class="GtkStringList">
                <items>
                  <item>top</item>
                  <item>bottom</item>
                  <item>left</item>
                  <item>right</item>
                </items>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwSpinRow" id="waybar_font_size">
            <property name="title">Font Size</property>
            <property name="subtitle">Override global size (0 for default)</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="value">0</property>
                <property name="lower">0</property>
                <property name="upper">50</property>
                <property name="step-increment">1</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwExpanderRow">
            <property name="title">Margins and Spacing</property>
            <property name="subtitle">Configure bar margins and module spacing</property>
            <child>
              <object class="AdwSpinRow" id="waybar_margin_top">
                <property name="title">Margin Top</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="value">0</property>
                    <property name="lower">0</property>
                    <property name="upper">100</property>
                    <property name="step-increment">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="waybar_margin_bottom">
                <property name="title">Margin Bottom</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="value">0</property>
                    <property name="lower">0</property>
                    <property name="upper">100</property>
                    <property name="step-increment">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="waybar_margin_left">
                <property name="title">Margin Left</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="value">0</property>
                    <property name="lower">0</property>
                    <property name="upper">100</property>
                    <property name="step-increment">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="waybar_margin_right">
                <property name="title">Margin Right</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="value">0</property>
                    <property name="lower">0</property>
                    <property name="upper">100</property>
                    <property name="step-increment">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="waybar_spacing">
                <property name="title">Module Spacing</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="value">0</property>
                    <property name="lower">0</property>
                    <property name="upper">50</property>
                    <property name="step-increment">1</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwSpinRow" id="waybar_height">
            <property name="title">Height</property>
            <property name="subtitle">Bar height (pixels)</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="value">46</property>
                <property name="lower">10</property>
                <property name="upper">200</property>
                <property name="step-increment">1</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title">User CSS</property>
            <property name="subtitle">~/.config/waybar/user.css</property>
          </object>
        </child>
        <child>
          <object class="AdwExpanderRow">
            <property name="title">Edit CSS</property>
            <property name="subtitle">Override Waybar styles</property>
            <child>
              <object class="GtkScrolledWindow">
                <property name="min-content-height">300</property>
                <property name="vexpand">True</property>
                <property name="has-frame">True</property>
                <child>
                  <object class="GtkTextView" id="waybar_editor">
                    <property name="monospace">True</property>
                    <property name="wrap-mode">none</property>
                    <property name="top-margin">10</property>
                    <property name="bottom-margin">10</property>
                    <property name="left-margin">10</property>
                    <property name="right-margin">10</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
