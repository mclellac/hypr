<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwPreferencesGroup" id="settings_group">
    <property name="title">Settings</property>
    <child>
      <object class="AdwSwitchRow" id="auto_cycle_toggle">
        <property name="title">Auto-Cycle Wallpapers</property>
        <property name="subtitle">Automatically change wallpaper at set intervals</property>
      </object>
    </child>
    <child>
      <object class="AdwSpinRow" id="cycle_interval">
        <property name="title">Cycle Interval (minutes)</property>
        <property name="adjustment">
          <object class="GtkAdjustment">
            <property name="value">30</property>
            <property name="lower">1</property>
            <property name="upper">1440</property>
            <property name="step-increment">1</property>
          </object>
        </property>
      </object>
    </child>
  </object>

  <object class="AdwPreferencesGroup" id="sources_group">
    <property name="title">Sources</property>
    <child>
      <object class="AdwExpanderRow" id="sources_expander">
        <property name="title">Manage Source Directories</property>
        <property name="subtitle">Add or remove directories containing wallpapers</property>
        <child type="suffix">
          <object class="GtkButton" id="add_source_btn">
            <property name="icon-name">list-add-symbolic</property>
            <property name="valign">center</property>
            <style>
              <class name="flat"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </object>

  <object class="AdwPreferencesGroup" id="selection_group">
    <property name="title">Select Wallpaper</property>
    <property name="header-suffix">
      <object class="GtkButton" id="import_btn">
        <property name="label">Import Image</property>
      </object>
    </property>
    <child>
       <object class="GtkScrolledWindow">
         <property name="vexpand">True</property>
         <property name="min-content-height">400</property>
         <property name="has-frame">True</property>
         <child>
           <object class="GtkFlowBox" id="flowbox">
             <property name="valign">start</property>
             <property name="max-children-per-line">4</property>
             <property name="min-children-per-line">2</property>
             <property name="selection-mode">none</property>
             <property name="column-spacing">12</property>
             <property name="row-spacing">12</property>
           </object>
         </child>
       </object>
    </child>
  </object>
</interface>
