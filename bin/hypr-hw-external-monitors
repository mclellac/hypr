#!/bin/bash
set -euo pipefail

# Returns true when an external monitor is physically connected.
# Uses kernel DRM state so the result is independent of Hyprland's startup timing.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    for status in /sys/class/drm/card*-*/status; do
      [[ "$status" == *-eDP-*/status ]] && continue
      [[ "$(<"$status")" == "connected" ]] && exit 0
    done
    exit 1
}

main "$@"
