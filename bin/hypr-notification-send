#!/bin/bash
#
# Sends desktop notifications (wrapper around notify-send / mako).

set -euo pipefail

_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    echo "Usage: $(basename "$0") [OPTIONS] TITLE MESSAGE"
}

main() {
    check_help "$@"

    if command -v notify-send &>/dev/null; then
        exec notify-send "$@"
    else
        log_info "$*"
    fi
}

main "$@"
