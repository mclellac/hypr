#!/bin/bash
#
# Returns true if AC power is connected.

set -euo pipefail
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    echo "Usage: $(basename "$0")"
    echo
    echo "Returns 0 if AC power is connected, 1 otherwise."
}

main() {
    check_help "$@"

    for ac in /sys/class/power_supply/AC* /sys/class/power_supply/ADP*; do
        if [[ -r "$ac/online" ]] && [[ "$(cat "$ac/online")" == "1" ]]; then
            exit 0
        fi
    done

    exit 1
}

main "$@"
