#!/bin/bash
#
# Returns a comma-separated string of ignored packages.

set -euo pipefail

# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Returns a comma-separated list of ignored packages.

Options:
  -h, --help    Show this help message and exit
EOF
}

main() {
    check_help "$@"

    local ignored_packages_file="${HYPR_PATH}/install/packages.ignored"

    if [[ -f "${ignored_packages_file}" ]]; then
        # tr replaces newlines with commas, and sed removes the trailing comma.
        tr '\r\n' ',' <"${ignored_packages_file}" | sed 's/,$//'
    fi
}

main "$@"
