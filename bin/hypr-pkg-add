#!/bin/bash
set -euo pipefail
#
# Installs one or more packages using 'pacman' if they are not already installed.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

#######################################
# Main function to install the specified packages.
# Globals:
#   None
# Arguments:
#   $@ - A list of package names to install.
# Outputs:
#   Exits with an error if pacman fails.
#######################################
main() {
    check_help "$@"
    if [[ $# -eq 0 ]]; then
        echo "Usage: $(basename "$0") <package1> [package2]..." >&2
        exit 1
    fi

    for pkg in "$@"; do
        # Check if the package is already installed or provided.
        if ! pacman -Q "${pkg}" &>/dev/null && ! pacman -T "${pkg}" &>/dev/null; then
            log_info "Installing ${pkg}..."
            # Install the package without confirmation.
            sudo pacman -S --noconfirm "${pkg}" || exit 1
        else
            log_info "${pkg} is already satisfied (installed or provided)."
        fi
    done

    exit 0
}

main "$@"
