#!/bin/bash
#
# Checks if an NVIDIA GPU without GSP firmware (Maxwell/Pascal/Volta) is active.

set -euo pipefail

_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    echo "Usage: $(basename "$0")"
    echo
    echo "Returns 0 if an NVIDIA GPU without GSP firmware is present, 1 otherwise."
}

main() {
    check_help "$@"

    if hypr-hw check nvidia && ! hypr-hw-nvidia-gsp; then
        exit 0
    fi

    exit 1
}

main "$@"
