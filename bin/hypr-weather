#!/bin/bash
set -euo pipefail

# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

# Configuration
CITY="Toronto"
CACHE_FILE="/tmp/hypr-weather-cache.json"

fetch_weather() {
    # 5s timeout to prevent Waybar hanging
    local raw_data
    # Added --retry 2 for better reliability
    raw_data=$(curl -s --max-time 5 --retry 2 "https://wttr.in/${CITY}?format=j1") || return 1

    # Check if we actually got valid JSON back
    if [[ -z "$raw_data" ]] || ! echo "$raw_data" | jq -e . >/dev/null 2>&1; then
        return 1
    fi

    # Process into Waybar format
    echo "$raw_data" | jq -c '
    (.current_condition[0] // .data.current_condition[0]) as $c |
    ($c.weatherDesc[0].value // "Unknown") as $desc |
    (if ($desc | contains("Sunny")) or ($desc | contains("Clear")) then ""
     elif ($desc | contains("Partly cloudy")) then ""
     elif ($desc | contains("Cloudy")) or ($desc | contains("Overcast")) then "☁"
     elif ($desc | contains("Rain")) or ($desc | contains("rain")) then "🌦"
     elif ($desc | contains("Snow")) or ($desc | contains("snow")) then "🌨"
     elif ($desc | contains("Mist")) or ($desc | contains("Fog")) then "🌫"
     else "" end) as $icon |
    {
      text: "\($icon) \($c.temp_C // "??")°C",
      tooltip: "\($desc)\nFeels like: \($c.FeelsLikeC // "??")°C\nHumidity: \($c.humidity // "??")%\nWind: \($c.windspeedKmph // "??")km/h \($c.winddir16Point // "")"
    }'
}

main() {
    check_help "$@"
    local new_weather

    # Try to fetch new data
    # Capture output and exit status separately to handle errors robustly
    if new_weather=$(fetch_weather) && [[ -n "$new_weather" ]] && echo "$new_weather" | jq -e . >/dev/null 2>&1; then
        # Success! Update cache and print
        echo "$new_weather" >"$CACHE_FILE"
        echo "$new_weather"
    else
        # Failure! Fallback to cache if it exists and is valid
        if [[ -f "$CACHE_FILE" ]] && jq -e . "$CACHE_FILE" >/dev/null 2>&1; then
            jq -c . "$CACHE_FILE"
        else
            # Absolute fallback if no cache exists yet or it's invalid
            echo '{"text": "", "tooltip": "Weather data unavailable (No Cache)"}'
        fi
    fi
}

main "$@"
