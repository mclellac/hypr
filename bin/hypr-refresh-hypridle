#!/bin/bash
set -euo pipefail
#
# Refreshes the hypridle configuration and restarts the service.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

#######################################
# Main function to refresh the hypridle configuration.
# Globals:
#   None
# Arguments:
#   None
# Outputs:
#   None
#######################################
main() {
    check_help "$@"
    hypr-refresh-config hypr/hypridle.conf
    hypr-restart-hypridle
}

main "$@"
