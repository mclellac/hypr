#!/bin/bash
set -euo pipefail

# Launch the TUI command passed in as an argument in the default terminal with an org.hypr.COMMAND app id for styling.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    if is_uwsm_active; then
        exec setsid uwsm-app -- xdg-terminal-exec --app-id="org.hypr.$(basename "$1")" -e "$1" "${@:2}"
    else
        exec setsid xdg-terminal-exec --app-id="org.hypr.$(basename "$1")" -e "$1" "${@:2}"
    fi
}

main "$@"

