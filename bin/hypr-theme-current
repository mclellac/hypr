#!/bin/bash
set -euo pipefail
#
# Prints the name of the currently active theme in a human-readable format.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

#######################################
# Main function to get and format the current theme name.
# Globals:
#   HOME - The user's home directory.
# Arguments:
#   None
# Outputs:
#   The formatted theme name to stdout.
#######################################
main() {
    check_help "$@"
  local theme_state="${HOME}/.config/hypr/current_theme_path"
  if [[ -f "${theme_state}" ]]; then
    local theme_path
    theme_path=$(<"${theme_state}")

    # Check if path is valid
    if [[ -d "${theme_path}" ]]; then
         # Extract basename
         basename "${theme_path}" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
    elif [[ -d "${HYPR_PATH}/themes/$(basename "${theme_path}")" ]]; then
         # Fallback to repo themes if path moved or relative
         basename "${theme_path}" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
    else
         log_info "Unknown (Path not found)"
    fi
  else
    log_info "Unknown"
  fi
}

main "$@"
