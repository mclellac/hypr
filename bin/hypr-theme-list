#!/bin/bash
set -euo pipefail
#
# Lists the available themes in a human-readable format.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

#######################################
# Main function to list and format theme names.
# Globals:
#   HOME - The user's home directory.
# Arguments:
#   None
# Outputs:
#   A newline-separated list of formatted theme names.
#######################################
main() {
    check_help "$@"
    local user_themes_dir="${HOME}/.config/hypr/themes"
    local system_themes_dir="${HYPR_PATH}/themes"
    local repo_themes_dir="${HYPR_PATH}/themes"
    
    local -a search_paths
    [[ -d "${user_themes_dir}" ]] && search_paths+=("${user_themes_dir}")
    [[ -d "${system_themes_dir}" ]] && search_paths+=("${system_themes_dir}")
    [[ -d "${repo_themes_dir}" ]] && search_paths+=("${repo_themes_dir}")

    if [[ ${#search_paths[@]} -gt 0 ]]; then
        find "${search_paths[@]}" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -exec basename {} \; 2>/dev/null | sort -u |
            while IFS= read -r theme; do
                # Capitalize words and replace hyphens for display.
                echo "${theme}" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
            done
    fi
}

main "$@"
