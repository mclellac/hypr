#!/bin/bash
set -euo pipefail

# Launch or focus on a given TUI identified by the passed in as the command.
# Use by commands like hypr-launch-wifi to ensure there is only one wifi configuration screen open.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    APP_ID="org.hypr.$(basename "$1")"
    LAUNCH_COMMAND="hypr-launch-tui $*"

    exec hypr-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
}

main "$@"
