#!/bin/bash
set -euo pipefail
#
# Installs Dropbox and its dependencies, then launches the client.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

#######################################
# Main function to install and start Dropbox.
# Globals:
#   None
# Arguments:
#   None
# Outputs:
#   Exits with an error if dependencies are not met.
#######################################
main() {
    check_help "$@"
    if ! command -v hypr-pkg-add &>/dev/null; then
        echo "Error: Required command not found: hypr-pkg-add" >&2
        exit 1
    fi

    log_info "Installing Dropbox and its dependencies..."
    hypr-pkg-add dropbox dropbox-cli libappindicator-gtk3 python-gpgme nautilus-dropbox

    log_info "Starting Dropbox client in the background..."
    # Launch via UWSM if active, otherwise launch directly.
    if is_uwsm_active; then
        setsid uwsm app -- dropbox-cli start &>/dev/null &
    else
        setsid dropbox-cli start &>/dev/null &
    fi

    log_info "Dropbox setup will continue in the system tray."
    log_info "Look for the Dropbox icon, right-click it, and follow the instructions."
}

main "$@"
