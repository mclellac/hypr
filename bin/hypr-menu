#!/bin/bash
#
# Provides a collection of dmenu-style menus for managing the Hyprland environment.

set -euo pipefail

# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [MENU_NAME]

Options:
  -h, --help    Show this help message and exit

Available Menus:
  Apps, Work, Socials, Resources, Capture, Style, Setup, Install, Remove, Update, About, System
EOF
}

#######################################
# Displays a dmenu-style menu using walker.
#######################################
menu() {
  local prompt="$1"
  local options="$2"
  local extra_args_str="${3:-}"
  local preselect="${4:-}"
  local -a args

  # shellcheck disable=SC2206
  args=($extra_args_str)

  if [[ -n "${preselect}" ]]; then
    local index
    index=$(echo -e "${options}" | grep -nxF "${preselect}" | cut -d: -f1)
    if [[ -n "${index}" ]]; then
      args+=("-c" "$((index - 1))")
    fi
  fi

  echo -e "${options}" | walker --dmenu -p "${prompt}…" "${args[@]}"
}

#######################################
# Launches a command in a new terminal window.
#######################################
terminal() {
  local terminal_bin="xterm"
  if command -v kitty >/dev/null 2>&1; then
    terminal_bin="kitty"
  elif command -v alacritty >/dev/null 2>&1; then
    terminal_bin="alacritty"
  fi

  if [ "$terminal_bin" = "kitty" ]; then
    kitty --class hypr "$@"
  elif [ "$terminal_bin" = "alacritty" ]; then
    alacritty --class hypr -e "$@"
  else
    xterm -class hypr -e "$@"
  fi
}

present_terminal() {
  hypr-exec "$1"
}

edit_in_nvim() {
  local terminal_bin="xterm"
  if command -v kitty >/dev/null 2>&1; then
    terminal_bin="kitty"
  elif command -v alacritty >/dev/null 2>&1; then
    terminal_bin="alacritty"
  fi

  notify-send "Editing config file" "Opened ${1} in Neovim" -t 5000 -i "text-editor"
  if [ "$terminal_bin" = "kitty" ]; then
    kitty nvim "$1"
  elif [ "$terminal_bin" = "alacritty" ]; then
    alacritty -e nvim "$1"
  else
    xterm -e nvim "$1"
  fi
}

install() {
  present_terminal "echo 'Installing $1...'; sudo pacman -S --noconfirm $2"
}

install_and_launch() {
  present_terminal "echo 'Installing $1...'; sudo pacman -S --noconfirm $2 && setsid gtk-launch $3"
}

install_font() {
  present_terminal "echo 'Installing $1...'; sudo pacman -S --noconfirm --needed $2 && sleep 2 && hypr-font-set '$3'"
}

aur_install() {
  present_terminal "echo 'Installing $1 from AUR...'; yay -S --noconfirm $2"
}

aur_install_and_launch() {
  present_terminal "echo 'Installing $1 from AUR...'; yay -S --noconfirm $2 && setsid gtk-launch $3"
}

