  local options="  Steam\n󰊗  Lutris\n󰊗  Heroic\n  RetroArch\n󰊗  Moonlight\n󰊗  GeForce NOW\n󰊗  Xbox Cloud\n󰊗  Xbox Controllers\n󰍳  Minecraft"
  local choice
  choice=$(menu "Remove" "${options}")

  case "${choice}" in
    *"Steam"*) present_terminal "hypr-remove-gaming-steam" ;;
    *"Lutris"*) present_terminal "hypr-remove-gaming-lutris" ;;
    *"Heroic"*) present_terminal "hypr-remove-gaming-heroic" ;;
    *"RetroArch"*) present_terminal "hypr-remove-gaming-retroarch" ;;
    *"Moonlight"*) present_terminal "hypr-remove-gaming-moonlight" ;;
    *"GeForce NOW"*) present_terminal "hypr-remove-gaming-geforce-now" ;;
    *"Xbox Cloud"*) present_terminal "hypr-remove-gaming-xbox-cloud" ;;
    *"Xbox Controllers"*) present_terminal "hypr-remove-gaming-xbox-controllers" ;;
    *"Minecraft"*) present_terminal "hypr-remove-gaming-minecraft" ;;
    *) show_remove_menu ;;
  esac
}

show_update_menu() {
  local options=" hypr\n  Config\n󰸌  Themes\n  Process\n󰇅  Hardware\n  Timezone"
  local choice
  choice=$(menu "Update" "${options}")

  case "${choice}" in
    *"hypr"*) present_terminal "hypr-update" ;;
    *"Config"*) show_update_config_menu ;;
    *"Themes"*) present_terminal "hypr-theme-update" ;;
    *"Process"*) show_update_process_menu ;;
    *"Hardware"*) show_update_hardware_menu ;;
    *"Timezone"*) hypr-cmd-tzupdate ;;
    *) show_main_menu ;;
  esac
}

show_update_process_menu() {
  local options="  Hypridle\n  Hyprsunset\n  Swayosd\n󰌧  Walker\n󰍜  Waybar"
  local choice
  choice=$(menu "Restart" "${options}")

  case "${choice}" in
    *"Hypridle"*) hypr-restart-hypridle ;;
    *"Hyprsunset"*) hypr-restart-hyprsunset ;;
    *"Swayosd"*) hypr-restart-swayosd ;;
    *"Walker"*) hypr-restart-walker ;;
    *"Waybar"*) hypr-restart-waybar ;;
    *) show_update_menu ;;
  esac
}

show_update_config_menu() {
  local options="  Hyprland\n  Hypridle\n  Hyprlock\n  Hyprsunset\n  Swayosd\n󰌧  Walker\n󰍜  Waybar"
  local choice
  choice=$(menu "Use default config" "${options}")

  case "${choice}" in
    *"Hyprland"*) present_terminal "hypr-refresh-hyprland" ;;
    *"Hypridle"*) present_terminal "hypr-refresh-hypridle" ;;
    *"Hyprlock"*) present_terminal "hypr-refresh-hyprlock" ;;
    *"Hyprsunset"*) present_terminal "hypr-refresh-hyprsunset" ;;
    *"Swayosd"*) present_terminal "hypr-refresh-swayosd" ;;
    *"Walker"*) present_terminal "hypr-refresh-walker" ;;
    *"Waybar"*) present_terminal "hypr-refresh-waybar" ;;
    *) show_update_menu ;;
  esac
}

show_update_hardware_menu() {
  local options="󱚾  Wi-Fi\n󰂯  Bluetooth"
  local choice
  choice=$(menu "Restart" "${options}")

  case "${choice}" in
    *"Wi-Fi"*) present_terminal "hypr-restart-wifi" ;;
    *"Bluetooth"*) present_terminal "hypr-restart-bluetooth" ;;
    *) show_update_menu ;;
  esac
}

show_system_menu() {
  local options="  Lock\n󱄄  Screensaver\n󰤄  Suspend\n  Relaunch\n󰜉  Restart\n󰐥  Shutdown"
  local choice
  choice=$(menu "System" "${options}")

  case "${choice}" in
    *"Lock"*) hypr-lock-screen ;;
    *"Screensaver"*) hypr-launch-screensaver force ;;
    *"Suspend"*) systemctl suspend ;;
    *"Relaunch"*) uwsm stop ;;
    *"Restart"*) systemctl reboot ;;
    *"Shutdown"*) systemctl poweroff ;;
    *) show_main_menu ;;
  esac
}

show_main_menu() {
  local options="󰀻  Apps\n󱃐  Work\n󰭹  Socials\n󰧑  Resources\n  Capture\n󰔎  Toggle\n  Style\n  Setup\n󰉉  Install\n󰭌  Remove\n  Update\n  About\n  System"
  go_to_menu "$(menu "Go" "${options}")"
}

go_to_menu() {
  local selection="${1,,}"
  case "${selection}" in
    *"apps"*) walker --provider desktopapplications -p "Launch…" ;;
    *"work"*) show_work_menu ;;
    *"socials"*) show_socials_menu ;;
    *"resources"*) show_resources_menu ;;
    *"style"*) show_style_menu ;;
    *"themes"*) show_theme_menu ;;
    *"theme"*) show_theme_menu ;;
    *"capture"*) show_capture_menu ;;
    *"screenshot"*) show_screenshot_menu ;;
    *"screenrecord"*) show_screenrecord_menu ;;
    *"toggle"*) show_toggle_menu ;;
    *"setup"*) show_setup_menu ;;
    *"power"*) show_setup_power_menu ;;
    *"install"*) show_install_menu ;;
    *"remove"*) show_remove_menu ;;
    *"update"*) show_update_menu ;;
    *"about"*)
      terminal bash -c 'fastfetch; read -n 1 -s'
      ;;
    *"system"*) show_system_menu ;;
  esac
}

main() {
  check_help "$@"

  # Ensure UTF-8 support for icons even if system locale is broken
  export LC_ALL=C.UTF-8

  if [[ -n "${1:-}" ]]; then
    go_to_menu "$1"
  else
    show_main_menu
  fi
}

main "$@"
