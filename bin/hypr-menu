show_style_menu() {
  local options="󰸌  Themes\n  Font\n  Preferences\n  Background\n󱄄  Screensaver\n  About"
  local choice
  choice=$(menu "Style" "${options}")

  case "${choice}" in
    *"Themes"*) show_theme_menu ;;
    *"Font"*) show_font_menu ;;
    *"Preferences"*) setsid uwsm app -- hypr-preferences-app >/dev/null 2>&1 & ;;
    *"Background"*) hypr-theme-bg-next ;;
    *"Screensaver"*) edit_in_nvim ~/.config/hypr/branding/screensaver.txt ;;
    *"About"*) edit_in_nvim ~/.config/hypr/branding/about.txt ;;
    *) show_main_menu ;;
  esac
}

show_theme_menu() {
  local theme
  theme=$(menu "Themes" "$(hypr-theme-list)" "" "$(hypr-theme-current)")
  if [[ "${theme}" != "CNCLD" && -n "${theme}" ]]; then
    local raw_theme
    raw_theme=$(echo "${theme}" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
    hypr-theme-set "${raw_theme}"
  else
    show_main_menu
  fi
}

show_font_menu() {
  local font
  font=$(menu "Font" "$(hypr-font-list)" "--width 350" "$(hypr-font-current)")
  if [[ "${font}" != "CNCLD" && -n "${font}" ]]; then
    hypr-font-set "${font}"
  else
    show_main_menu
  fi
}

show_capture_menu() {
  local options="  Screenshot\n  Screenrecord\n󰎫  Text (OCR)\n󰑃  Transcode\n󰑃  Transcode ASCII\n󰃉  Color"
  local choice
  choice=$(menu "Capture" "${options}")

  case "${choice}" in
    *"Screenshot"*) show_screenshot_menu ;;
    *"Screenrecord"*) show_screenrecord_menu ;;
    *"Text"*) present_terminal "hypr-capture-text-extraction" ;;
    *"Transcode ASCII"*) present_terminal "hypr-transcode-ascii" ;;
    *"Transcode"*) present_terminal "hypr-transcode" ;;
    *"Color"*) pkill hyprpicker || hyprpicker -a ;;
    *) show_main_menu ;;
  esac
}

show_screenshot_menu() {
  local options="  Region\n  Window\n  Display"
  local choice
  choice=$(menu "Screenshot" "${options}")

  case "${choice}" in
    *"Region"*) hypr-capture-screenshot region ;;
    *"Window"*) hypr-capture-screenshot windows ;;
    *"Display"*) hypr-capture-screenshot fullscreen ;;
    *) show_capture_menu ;;
  esac
}

show_screenrecord_menu() {
  local options="  Region\n  Display"
  local choice
  choice=$(menu "Screenrecord" "${options}")

  case "${choice}" in
    *"Region"*) hypr-capture-screenrecording ;;
    *"Display"*) hypr-capture-screenrecording ;;
    *) show_capture_menu ;;
  esac
}

show_toggle_menu() {
  local options="󱄄  Screensaver\n󰔎  Nightlight\n󱫖  Idle Lock\n󰍜  Top Bar\n󰊗  Gaming Mode\n󰘔  Zen Mode"
