  case "${choice}" in
    *"Node"*) present_terminal "hypr-install-dev-env node" ;;
    *"Bun"*) present_terminal "hypr-install-dev-env bun" ;;
    *"Deno"*) present_terminal "hypr-install-dev-env deno" ;;
    *) show_install_development_menu ;;
