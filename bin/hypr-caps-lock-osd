#!/bin/bash
#
# Detects the current Caps Lock state and displays an OSD message using swayosd.
# Uses multiple sources of truth (hyprctl + sysfs leds) to be as accurate as possible.

set -euo pipefail

# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    # Critical delay: hardware and Hyprland state need time to propagate
    # We use a slightly longer delay to ensure LED sync finishes
    sleep 0.15

    # We use the standard --caps-lock flag because swayosd uses it to
    # synchronize the internal state and the hardware LED if configured.
    # We call it AFTER the sleep so it picks up the correct toggled state.
    exec hypr-swayosd-client --caps-lock
}

main "$@"
