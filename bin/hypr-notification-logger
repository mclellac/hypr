#!/usr/bin/env python3
"""Logs notifications to a file."""
import json
import os
import re
import subprocess
import time

# pylint: disable=invalid-name

HYPR_PATH = os.environ.get("HYPR_PATH", os.path.expanduser("~/.local/share/hypr"))
LOG_FILE = os.path.join(HYPR_PATH, "notifications.json")
MAX_LOGS = 50

# List of summaries or keywords that indicate an unimportant notification
# that should NOT be saved in the history.
UNIMPORTANT_SUMMARIES = [
    "Theme Applied",
    "Gaming Mode",
    "Window Gaps",
    "Workspace layout",
    "Nightlight",
    "Daylight",
    "locking computer",
    "Silenced notifications",
    "Enabled notifications",
    "Display scaling",
    "Controller connected",
    "Controller disconnected",
    "Battery level",
    "Power profile",
    "Editing config file",
    "Screenshot captured",
    "Screen recording",
]

# List of app names to ignore completely in history
IGNORE_APPS = [
    "hypr-toggle",
    "hypr-theme-set",
    "swayosd-client",
    "SwayOSD",
]


def should_log(app_name, summary, body):
    """Determines if a notification is important enough to log in history."""
    # Filter by app name
    if app_name in IGNORE_APPS:
        return False

    # Filter by summary keywords (case-insensitive)
    all_text = (summary + " " + body).lower()
    
    for keyword in UNIMPORTANT_SUMMARIES:
        if keyword.lower() in all_text:
            return False

    # Filter specific hardware/theme noise patterns
    if "controller" in all_text and ("connected" in all_text or "paired" in all_text):
        return False
        
    if "applied" in all_text and "theme" in all_text:
        return False
        
    if "display" in all_text and "scaling" in all_text:
        return False

    return True


def log_notification(notification):
    """Logs the given notification to the history file."""
    app_name = notification.get("app_name", "")
    summary = notification.get("summary", "")
    body = notification.get("body", "")
    
    if not should_log(app_name, summary, body):
        return

    try:
        if os.path.exists(LOG_FILE):
            with open(LOG_FILE, 'r', encoding='utf-8') as f:
                logs = json.load(f)
        else:
            logs = []
    except (json.JSONDecodeError, FileNotFoundError):
        logs = []

    # Prepend new notification
    logs.insert(0, notification)
    logs = logs[:MAX_LOGS]

    with open(LOG_FILE, 'w', encoding='utf-8') as f:
        json.dump(logs, f, indent=2)

    # Send SIGRTMIN+10 (44) to waybar to refresh the module
    try:
        subprocess.run(["pkill", "-RTMIN+10", "waybar"], stderr=subprocess.DEVNULL, check=False)
    except Exception:  # pylint: disable=broad-except
        pass


def main():
    """Main function to listen for notifications."""
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)

    cmd = ["dbus-monitor", "interface=org.freedesktop.Notifications,member=Notify"]
    with subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, bufsize=1) as process:
        # Regexes
        re_string = re.compile(r'^\s*string "(.*)"$')
        re_uint32 = re.compile(r'^\s*uint32 (\d+)$')

        current_notif = None

        while True:
            line = process.stdout.readline()
            if not line:
                break
            line = line.strip()

            if line.startswith("method call"):
                # If we had a pending notification that was mostly parsed, we could log it here
                # But the Notify signature is well-defined.
                current_notif = {"timestamp": time.time(), "strings": []}
                continue
            
            if current_notif is None:
                continue

            m_str = re_string.match(line)
            if m_str:
                val = m_str.group(1).replace('\\"', '"').replace('\\n', '\n')
                current_notif["strings"].append(val)

            m_ui = re_uint32.match(line)
            if m_ui and "replaces_id" not in current_notif:
                current_notif["replaces_id"] = int(m_ui.group(1))

            # Once we have enough data, log it
            # Actually, let's just collect all 4 strings we care about
            if len(current_notif["strings"]) == 4:
                notif_to_log = {
                    "timestamp": current_notif["timestamp"],
                    "app_name": current_notif["strings"][0],
                    "icon": current_notif["strings"][1],
                    "summary": current_notif["strings"][2],
                    "body": current_notif["strings"][3]
                }
                log_notification(notif_to_log)
                current_notif = None # Done with this one

if __name__ == "__main__":
    main()
