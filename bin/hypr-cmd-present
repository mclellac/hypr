#!/bin/bash
#
# Checks if one or more command-line tools are present in the system's PATH.
# The script iterates through the provided arguments and exits with failure (1)
# if any of the commands are not found. It succeeds (exits 0) only if all
# specified commands are present.

set -euo pipefail
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    echo "Usage: $(basename "$0") <command1> [command2]..."
    echo
    echo "Checks if specified commands are present in the system's PATH."
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message and exit"
}

#######################################
# Main function to check for present commands.
# Globals:
#   None
# Arguments:
#   $@ - A list of command names to check.
# Outputs:
#   Exits with status 0 if all commands are present.
#   Exits with status 1 if any command is missing.
#   Exits with status 2 if no arguments are provided.
#######################################
main() {
    check_help "$@"

    if [[ $# -eq 0 ]]; then
        usage >&2
        exit 2
    fi

    for cmd in "$@"; do
        # 'command -v' is a reliable way to check if a command exists in the PATH.
        # Output is redirected to /dev/null to suppress command path output.
        if ! command -v "${cmd}" &>/dev/null; then
            # If a command is not found, exit with failure (1).
            exit 1
        fi
    done

    # If the loop completes, it means all specified commands were found.
    exit 0
}

main "$@"
