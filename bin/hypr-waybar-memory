#!/usr/bin/env python3
"""Memory usage module for Waybar."""
import json
import subprocess

# pylint: disable=invalid-name,broad-except

def main():
    """Main function to get memory usage and top processes."""
    try:
        cmd_mem = "free -m | awk 'NR==2{printf \"%.0f\", $3*100/$2 }'"
        mem_info = float(subprocess.check_output(cmd_mem, shell=True, text=True).strip())
    except Exception:
        mem_info = 0.0

    try:
        cmd_procs = (
            "ps -Ao comm,pmem --sort=-pmem | head -n 6 | "
            "awk 'NR>1 {printf \"%-15s %s%%\\n\", $1, $2}'"
        )
        procs = subprocess.check_output(cmd_procs, shell=True, text=True).strip()
    except Exception:
        procs = ""

    tooltip = f"Memory Usage: {mem_info:.0f}%\n\nTop Processes:\n{procs}"

    css_class = "normal"
    if mem_info >= 90:
        css_class = "critical"
    elif mem_info >= 70:
        css_class = "warning"

    print(json.dumps({
        "text": f"󰍛 {mem_info:.0f}%",
        "tooltip": tooltip,
        "class": css_class
    }))

if __name__ == "__main__":
    main()
