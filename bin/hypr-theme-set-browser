#!/usr/bin/env python3
# pylint: disable=invalid-name,too-many-branches
"""Theme synchronization tool for Chromium-based browsers.

Saves current theme background color to enterprise policies and triggers a
real-time policy reload for active browsers under the current user context.
"""

import glob
import json
import os
import shutil
import subprocess


def get_theme_color():
    """Retrieve the current theme color for browsers from the config manager."""
    for key in [
        "colors.chromium_frame",
        "colors.accent",
        "colors.primary",
        "colors.background",
    ]:
        try:
            res = subprocess.run(
                ["hypr-theme-get", key],
                capture_output=True,
                text=True,
                check=True,
            )
            color_hex = res.stdout.strip()
            if color_hex.startswith("#") and len(color_hex) >= 7:
                return color_hex[:7]
        except Exception:
            pass
    return "#1e1e2e"


def hex_to_skcolor(hex_str):
    """Convert hex color string to SkColor integer representation."""
    hex_str = hex_str.lstrip("#")
    if len(hex_str) == 6:
        r = int(hex_str[0:2], 16)
        g = int(hex_str[2:4], 16)
        b = int(hex_str[4:6], 16)
        return (255 << 24) | (r << 16) | (g << 8) | b
    return 0


def is_browser_running(proc_name):
    """Check if a browser process is currently active."""
    try:
        res = subprocess.run(
            ["pgrep", "-x", proc_name], capture_output=True, check=False
        )
        return res.returncode == 0
    except Exception:
        return False


def update_preferences(pref_path, sk_color, is_dark):
    """Update theme color preferences on disk for closed browsers."""
    if not os.path.exists(pref_path):
        return
    try:
        with open(pref_path, "r", encoding="utf-8", errors="ignore") as f:
            data = json.load(f)
    except Exception:
        return

    # Initialize nested dictionaries if they do not exist
    if "browser" not in data or not isinstance(data["browser"], dict):
        data["browser"] = {}
    if "theme" not in data["browser"] or not isinstance(
        data["browser"]["theme"], dict
    ):
        data["browser"]["theme"] = {}

    theme_data = data["browser"]["theme"]
    theme_data["user_color"] = sk_color
    theme_data["user_color2"] = sk_color
    theme_data["color_variant"] = 1
    theme_data["color_variant2"] = 1
    theme_data["color_scheme"] = 2 if is_dark else 1
    theme_data["color_scheme2"] = 2 if is_dark else 1
    theme_data["follows_system_colors"] = False
    theme_data.pop("saved_local_theme", None)
    theme_data.pop("saved_local_theme2", None)

    if "autogenerated" not in data or not isinstance(
        data["autogenerated"], dict
    ):
        data["autogenerated"] = {}
    if "theme" not in data["autogenerated"] or not isinstance(
        data["autogenerated"]["theme"], dict
    ):
        data["autogenerated"]["theme"] = {}
    data["autogenerated"]["theme"]["color"] = sk_color

    try:
        tmp_path = pref_path + ".tmp"
        with open(tmp_path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
        os.replace(tmp_path, pref_path)
    except Exception:
        pass


def main():
    """Execute main theme updates and active browser reloads."""
    color_hex = get_theme_color()
    sk_color = hex_to_skcolor(color_hex)
    is_dark = True  # Standard dark variant matching

    config_home = os.path.expanduser("~/.config")
    browsers = {
        "chrome": [
            "google-chrome",
            "google-chrome-unstable",
            "google-chrome-beta",
            "google-chrome-dev",
        ],
        "chromium": ["chromium"],
        "brave": ["BraveSoftware/Brave-Browser"],
        "thorium": ["thorium", "thorium-browser"],
        "vivaldi": ["vivaldi", "vivaldi-snapshot"],
        "msedge": [
            "microsoft-edge",
            "microsoft-edge-beta",
            "microsoft-edge-dev",
            "microsoft-edge-unstable",
        ],
        "opera": ["opera", "opera-beta", "opera-developer"],
    }

    # Safely update Preferences files on disk for browsers that are NOT currently running
    for proc_name, config_dirs in browsers.items():
        if is_browser_running(proc_name):
            continue
        for cdir in config_dirs:
            base_path = os.path.join(config_home, cdir)
            if not os.path.exists(base_path):
                continue

            # Find Preferences paths (including recovery targets)
            pref_paths = set()
            for p in glob.glob(
                os.path.join(base_path, "**/Preferences"), recursive=True
            ):
                pref_paths.add(p)
            for p in glob.glob(
                os.path.join(base_path, "**/Preferences.corrupt"),
                recursive=True,
            ):
                pref_paths.add(p.replace(".corrupt", ""))

            for pref_path in pref_paths:
                update_preferences(pref_path, sk_color, is_dark)

    # Invoke passwordless system policy helper to update all policy files in /etc
    # (requires root/sudo)
    try:
        hypr_path = os.environ.get("HYPR_PATH")
        if hypr_path:
            helper_path = os.path.join(hypr_path, "bin", "hypr-theme-set-browser-policy")
        else:
            helper_path = os.path.expanduser(
                "~/.local/share/hypr/bin/hypr-theme-set-browser-policy"
            )
        if os.path.exists(helper_path):
            subprocess.run(
                ["sudo", "-n", helper_path, color_hex],
                capture_output=True,
                timeout=5,
                check=False,
            )
    except Exception as e:
        print(f"Skipped policy update: {e}")

    # Reload policies for any running browsers as the CURRENT active user
    # (running this command as root/sudo locks user profiles and causes session restore bugs)
    browsers_to_reload = [
        ("chrome", "google-chrome-stable"),
        ("chrome", "google-chrome"),
        ("chrome", "google-chrome-unstable"),
        ("chrome", "google-chrome-beta"),
        ("chromium", "chromium"),
        ("brave", "brave-browser"),
        ("vivaldi", "vivaldi-stable"),
        ("thorium", "thorium-browser"),
        ("edge", "microsoft-edge-stable"),
    ]

    for proc_name, binary in browsers_to_reload:
        if is_browser_running(proc_name):
            if shutil.which(binary):
                try:
                    subprocess.run(
                        [
                            binary,
                            "--refresh-platform-policy",
                            "--no-startup-window",
                        ],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        timeout=3,
                        check=False,
                    )
                except Exception:
                    pass

    print("Successfully updated browser themes.")


if __name__ == "__main__":
    main()
