#!/bin/bash
set -euo pipefail

# Clean up the voxtype --follow child when Waybar reloads

# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    trap 'kill 0' EXIT

    if hypr-cmd-present voxtype; then
      voxtype status --follow --extended --format json | while read -r line; do
        echo "$line" | jq -c '. + {alt: .class}'
      done
    else
      echo '{"alt": "", "tooltip": ""}'
    fi
}

main "$@"
