#!/bin/bash
#
# Refresh application-specific themes that are not handled by Jinja2 templates.
# Note: Primary templating and GNOME/GTK settings are handled by hypr_config_manager.

set -euo pipefail
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Refreshes application-specific themes (VSCode, Obsidian, Browser, etc.)
that are not directly handled by the main Jinja2 templates.

Options:
  -h, --help    Show this help message and exit
EOF
}

main() {
    check_help "$@"

    log_info "Refreshing application themes..."

    # Sync themes to browsers
    if command -v hypr-theme-set-browser &>/dev/null; then
        hypr-theme-set-browser || log_warn "Failed to set browser theme."
    fi

    # Sync themes to editors
    if command -v hypr-theme-set-vscode &>/dev/null; then
        hypr-theme-set-vscode || log_warn "Failed to set VSCode theme."
    fi

    # Sync themes to Obsidian
    if command -v hypr-theme-set-obsidian &>/dev/null; then
        hypr-theme-set-obsidian || log_warn "Failed to set Obsidian theme."
    fi

    # Sync themes to Keyboard RGB
    if command -v hypr-theme-set-keyboard &>/dev/null; then
        hypr-theme-set-keyboard || log_warn "Failed to set keyboard theme."
    fi

    log_info "Application theme refresh complete."
}

main "$@"
