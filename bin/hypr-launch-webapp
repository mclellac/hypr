#!/bin/bash
set -euo pipefail
#
# Launches a web application (a URL in a browser with app-like flags)
# using a supported browser.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

#######################################
# Determines the default browser to use for webapps.
# Globals:
#   None
# Arguments:
#   None
# Outputs:
#   The .desktop filename of a supported browser.
#######################################
get_default_browser() {
    local browser
    browser=$(timeout 1s env -u KDE_SESSION_VERSION -u KDE_FULL_SESSION xdg-settings get default-web-browser 2>/dev/null || echo "")

    if [[ -n "${browser}" ]]; then
        echo "${browser}"
        return 0
    fi

    echo "chromium.desktop"
}

#######################################
# Main function to launch the web application.
# Globals:
#   None
# Arguments:
#   $1 - The URL to open as a web app.
#   $@ - Additional arguments for the browser.
# Outputs:
#   Exits with an error if the URL or browser executable is not found.
#######################################
main() {
    check_help "$@"
    if [[ -z "${1:-}" ]]; then
        echo "Usage: $(basename "$0") <url> [browser-args...]" >&2
        exit 1
    fi

    local url="$1"
    shift

    local browser_desktop_file
    browser_desktop_file=$(get_default_browser)

    local -a search_dirs=(
        "${HOME}/.local/share/applications"
        "${HOME}/.nix-profile/share/applications"
        "/usr/share/applications"
    )
    local desktop_file_path=""

    for dir in "${search_dirs[@]}"; do
        if [[ -f "${dir}/${browser_desktop_file}" ]]; then
            desktop_file_path="${dir}/${browser_desktop_file}"
            break
        fi
    done

    if [[ -z "${desktop_file_path}" ]]; then
        log_warn "Could not find .desktop file for '${browser_desktop_file}'. Attempting fallbacks..."
        local fallback
        for fallback in chromium.desktop google-chrome.desktop firefox.desktop; do
            for dir in "${search_dirs[@]}"; do
                if [[ -f "${dir}/${fallback}" ]]; then
                    desktop_file_path="${dir}/${fallback}"
                    browser_desktop_file="${fallback}"
                    break 2
                fi
            done
        done
    fi

    if [[ -z "${desktop_file_path}" ]]; then
        echo "Error: Could not find .desktop file for default or fallback browser." >&2
        exit 1
    fi

    # Read the Exec line from the desktop file and remove field codes.
    local exec_line
    exec_line=$(grep -E '^Exec=' "${desktop_file_path}" | head -1 | sed -e 's/^Exec=//' -e 's/ %[UufF]//g')
    if [[ -z "${exec_line}" ]]; then
        echo "ERROR: Could not find the Exec line in '${desktop_file_path}'." >&2
        exit 1
    fi

    # Determine flags based on the browser.
    # Chromium browsers support --app for a PWA experience.
    # Firefox and its derivatives (LibreWolf, Zen, Nightly, etc.) do not.
    local app_flag=""
    case "${browser_desktop_file}:${exec_line}" in
        *[Ff]irefox*|*[Nn]ightly*|*[Ll]ibrewolf*|*[Zz]en*|*[Ww]aterfox*|*[Ff]loorp*|*[Mm]ozilla*)
            app_flag="\"${url}\""
            ;;
        *)
            app_flag="--app=\"${url}\""
            ;;
    esac

    # Launch the browser. `eval` handles potential quotes in exec_line.
    if is_uwsm_active; then
        eval "exec setsid uwsm-app -- ${exec_line} ${app_flag} \"\$@\""
    else
        eval "exec setsid ${exec_line} ${app_flag} \"\$@\""
    fi
}

main "$@"

