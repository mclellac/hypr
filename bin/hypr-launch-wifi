#!/bin/bash
set -euo pipefail

# Launch the Hypr wifi controls (provided by the Impala TUI).
# Attempts to unblock the wifi service first in case it should be been blocked.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    rfkill unblock wifi
    hypr-launch-or-focus-tui impala
}

main "$@"
