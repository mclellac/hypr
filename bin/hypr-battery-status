#!/bin/bash
#
# Prints current battery capacity and status.

set -euo pipefail

_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    echo "Usage: $(basename "$0")"
    echo
    echo "Prints current battery percentage and charging state."
}

main() {
    check_help "$@"

    local battery_device
    battery_device=$(upower -e | grep 'BAT' | head -n 1 || true)

    if [[ -z "${battery_device}" ]]; then
        echo "No battery"
        exit 0
    fi

    local info
    info=$(upower -i "${battery_device}")
    local percentage
    percentage=$(echo "$info" | awk -F: '/percentage/ {gsub(/[%[:space:]]/, "", $2); print $2}')
    local state
    state=$(echo "$info" | awk -F: '/state/ {gsub(/[[:space:]]/, "", $2); print $2}')

    echo "${state} ${percentage}%"
}

main "$@"
