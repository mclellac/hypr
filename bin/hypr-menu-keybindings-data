#!/usr/bin/env python3
"""Fetches and displays keybindings for walker/rofi."""
import json
import subprocess
import sys

# pylint: disable=invalid-name

def main():
    """Main function."""
    try:
        # Run hypr-theme-get keybindings to get JSON representation of active keybindings
        result = subprocess.run(
            ['hypr-theme-get', 'keybindings'],
            capture_output=True,
            text=True,
            check=True
        )
        bindings = json.loads(result.stdout)
    except Exception as e: # pylint: disable=broad-except
        print(f"Error getting keybindings via hypr-theme-get: {e}", file=sys.stderr)
        sys.exit(1)
    
    # Use a set to track unique combinations to avoid duplicates
    seen = set()
    
    for b in bindings:
        if b.get('type') == 'unbind':
            continue
            
        mods = b.get('mods', '')
        key = b.get('key', '')
        
        # Normalize key combo for display
        mods_display = mods.replace('$mainMod', 'SUPER').replace(' ', ' + ').strip(' + ')
        if mods_display:
            key_combo = f"{mods_display} + {key}"
        else:
            key_combo = key
            
        desc = b.get('desc', '')
        if not desc:
            dispatcher = b.get('dispatcher', '')
            arg = b.get('arg', '')
            desc = f"{dispatcher} {arg}".strip()
            
        # Avoid showing the exact same combo twice if it has the same description
        combo_tuple = (key_combo, desc)
        if combo_tuple in seen:
            continue
        seen.add(combo_tuple)
        
        # Escape XML entities for Pango markup (walker uses it)
        desc = desc.replace('&', '&amp;').replace('<', '&lt;')
        desc = desc.replace('>', '&gt;').replace('"', '&quot;').replace("'", '&apos;')
        
        print(f"{key_combo:<35} → {desc}")

if __name__ == "__main__":
    main()
