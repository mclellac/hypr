#!/bin/bash
set -euo pipefail

# Upload logs to 0x0.st


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    LOG_TYPE="${1:-install}"
    TEMP_LOG="/tmp/upload-log.txt"
    SYSTEM_INFO="/tmp/system-info.txt"

    # Get system information if fastfetch is available
    if command -v fastfetch >/dev/null 2>&1; then
      {
        log_info "========================================="
        log_info "SYSTEM INFORMATION"
        log_info "========================================="
        # Use fastfetch with no logo to get clean output
        fastfetch --logo none --pipe 2>/dev/null || echo "Failed to get system info"
        echo ""
        log_info "========================================="
        log_info "LOG CONTENT"
        log_info "========================================="
        echo ""
      } >"$SYSTEM_INFO"
    else
      # Fallback to basic info if fastfetch isn't available
      {
        log_info "========================================="
        log_info "SYSTEM INFORMATION"
        log_info "========================================="
        log_info "Hostname: $(hostname)"
        log_info "Kernel: $(uname -r)"
        log_info "Date: $(date)"
        echo ""
        log_info "========================================="
        log_info "LOG CONTENT"
        log_info "========================================="
        echo ""
      } >"$SYSTEM_INFO"
    fi

    case "$LOG_TYPE" in
    install)
      ARCHINSTALL_LOG="/var/log/archinstall/install.log"
      HYPR_LOG="/var/log/hypr-install.log"

      # Combine system info with logs
      cat "$SYSTEM_INFO" >"$TEMP_LOG"
      cat $ARCHINSTALL_LOG $HYPR_LOG >>"$TEMP_LOG" 2>/dev/null

      if [[ ! -s $TEMP_LOG ]]; then
        log_info "Error: No install logs found"
        exit 1
      fi

      log_info "Uploading installation log to 0x0.st..."
      ;;

    this-boot)
      # Combine system info with boot logs
      cat "$SYSTEM_INFO" >"$TEMP_LOG"
      journalctl -b 0 >>"$TEMP_LOG" 2>/dev/null

      if [[ ! -s $TEMP_LOG ]]; then
        log_info "Error: No logs found for current boot"
        exit 1
      fi

      log_info "Uploading current boot logs to 0x0.st..."
      ;;

    last-boot)
      # Combine system info with previous boot logs
      cat "$SYSTEM_INFO" >"$TEMP_LOG"
      journalctl -b -1 >>"$TEMP_LOG" 2>/dev/null

      if [[ ! -s $TEMP_LOG ]]; then
        log_info "Error: No logs found for previous boot"
        exit 1
      fi

      log_info "Uploading previous boot logs to 0x0.st..."
      ;;

    installed|system-info)
      # System info plus all installed packages
      cat "$SYSTEM_INFO" >"$TEMP_LOG"
      {
        echo ""
        log_info "========================================="
        log_info "INSTALLED PACKAGES (pacman -Q)"
        log_info "========================================="
        pacman -Q 2>/dev/null || echo "Failed to get package list"
      } >>"$TEMP_LOG"

      if [[ ! -s $TEMP_LOG ]]; then
        log_info "Error: Failed to gather system information"
        exit 1
      fi

      log_info "Uploading system information to 0x0.st..."
      ;;

    *)
      log_info "Usage: $0 [install|this-boot|last-boot|installed|system-info]"
      log_info "  install      - Upload installation logs (default)"
      log_info "  this-boot    - Upload logs from current boot"
      log_info "  last-boot    - Upload logs from previous boot"
      log_info "  installed    - Upload system info and installed packages"
      exit 1
      ;;
    esac

    echo ""

    if URL=$(curl -sF "file=@$TEMP_LOG" -Fexpires=24 https://0x0.st) && [[ -n $URL ]]; then
      log_info "✓ Log uploaded successfully!"
      log_info "Share this URL:"
      echo ""
      log_info "  $URL"
      echo ""
      log_info "This link will expire in 24 hours."
    else
      log_info "Error: Failed to upload log file"
      exit 1
    fi
}

main "$@"
