#!/bin/bash
#
# Audits mako theme configurations to ensure consistent timeouts and remove
# deprecated settings.

set -euo pipefail
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

THEMES_DIR="themes"

usage() {
    echo "Usage: $(basename "$0") [OPTIONS]"
    echo
    echo "Audits mako theme configurations for consistent timeouts."
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message and exit"
}

audit_mako() {
    local filepath="$1"
    local temp_file
    temp_file=$(mktemp)
    
    local in_section=false
    local has_global_timeout=false
    
    while IFS= read -r line || [[ -n "${line}" ]]; do
        local stripped
        stripped=$(echo "${line}" | xargs)
        
        if [[ "${stripped}" =~ ^\[.*\]$ ]]; then
            if [[ "${stripped}" == "[global]" ]]; then
                in_section=false
            else
                in_section=true
            fi
        fi
        
        if [[ "${stripped}" =~ ^default-timeout= ]]; then
            if [[ "${in_section}" == "false" ]]; then
                has_global_timeout=true
            fi
            
            local value
            value=$(echo "${stripped}" | cut -d'=' -f2)
            if [[ "${value}" == "0" ]]; then
                echo "default-timeout=5000" >> "${temp_file}"
                continue
            fi
        fi
        
        if [[ "${stripped}" =~ ^overflow= ]]; then
            continue
        fi
        
        echo "${line}" >> "${temp_file}"
    done < "${filepath}"
    
    if [[ "${has_global_timeout}" == "false" ]]; then
        # Insert at the beginning or after initial comments
        local final_file
        final_file=$(mktemp)
        echo "default-timeout=5000" > "${final_file}"
        cat "${temp_file}" >> "${final_file}"
        mv "${final_file}" "${filepath}"
    else
        mv "${temp_file}" "${filepath}"
    fi
    rm -f "${temp_file}"
}

main() {
    check_help "$@"

    if [[ ! -d "${THEMES_DIR}" ]]; then
        log_error "Themes directory ${THEMES_DIR} not found."
        return
    fi

    find "${THEMES_DIR}" -name "mako.theme.conf" | while read -r f; do
        log_info "Auditing ${f}..."
        audit_mako "${f}"
    done
}

main "$@"
