#!/bin/bash
set -euo pipefail

# Set a new encryption password for a drive selected.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    encrypted_drives=$(blkid -t TYPE=crypto_LUKS -o device)

    if [[ -n $encrypted_drives ]]; then
      if (( $(wc -l <<<"$encrypted_drives") == 1 )); then
        drive_to_change="$encrypted_drives"
      else
        drive_to_change="$(hypr-drive-select "$encrypted_drives")"
      fi

      if [[ -n $drive_to_change ]]; then
        log_info "Changing full-disk encryption password for $drive_to_change"
        sudo cryptsetup luksChangeKey --pbkdf argon2id --iter-time 2000 "$drive_to_change"
      else
        log_info "No drive selected."
      fi
    else
      log_info "No encrypted drives available."
      exit 1
    fi
}

main "$@"
