#!/bin/bash
set -euo pipefail

# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"
    if [[ $# -eq 0 ]]; then
        echo "Usage: $(basename "$0") <command>" >&2
        exit 1
    fi

    local terminal
    # Try to get terminal from theme, but ignore the default 'ghostty' if we are in a VM
    terminal=$(hypr-theme-get terminal)
    
    if systemd-detect-virt -q; then
        # If we are in a VM, and the theme hasn't explicitly set a terminal 
        # (other than the global default 'ghostty'), we use alacritty.
        if [[ "$terminal" == "ghostty" ]] || [[ -z "$terminal" ]]; then
            terminal="alacritty"
        fi
    fi

    # Final fallback
    if [[ -z "$terminal" ]]; then
        terminal="ghostty"
    fi

    local args=()

    case "$terminal" in
    ghostty)
        args+=("--title=hypr-exec")
        ;;
    alacritty | kitty)
        args+=("--class" "hypr-exec")
        args+=("--title" "hypr-exec")
        ;;
    *)
        args+=("--class" "hypr-exec")
        args+=("--title" "hypr-exec")
        ;;
    esac

    # Ensure we pass the command correctly to different terminals
    if is_uwsm_active; then
        case "$terminal" in
        kitty | alacritty | ghostty)
            setsid uwsm app -- "$terminal" "${args[@]}" -e bash -c 'hypr-show-logo; "$@"; echo; hypr-show-done' -- "$@"
            ;;
        *)
            setsid uwsm app -- "$terminal" "${args[@]}" -e "$@"
            ;;
        esac
    else
        case "$terminal" in
        kitty | alacritty | ghostty)
            setsid "$terminal" "${args[@]}" -e bash -c 'hypr-show-logo; "$@"; echo; hypr-show-done' -- "$@"
            ;;
        *)
            setsid "$terminal" "${args[@]}" -e "$@"
            ;;
        esac
    fi
}

main "$@"

