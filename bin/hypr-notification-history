#!/usr/bin/env python3
"""Displays notification history in walker."""
import json
import os
import re
import subprocess

# pylint: disable=invalid-name

HYPR_PATH = os.environ.get("HYPR_PATH", os.path.expanduser("~/.local/share/hypr"))
LOG_FILE = os.path.join(HYPR_PATH, "notifications.json")


def main():
    """Main function to display history."""
    if not os.path.exists(LOG_FILE):
        logs = []
    else:
        try:
            with open(LOG_FILE, 'r', encoding='utf-8') as f:
                logs = json.load(f)
        except json.JSONDecodeError:
            logs = []

    if not logs:
        # Use walker to show "No notifications"
        dmenu_input = "No notifications"
    else:
        # Format entries for walker
        entries = []
        entry_map = {}

        for notif in logs:  # Already in reverse chronological order
            app = notif.get("app_name", "Unknown")
            summary = notif.get("summary", "")
            # Remove newlines for single line display
            body = notif.get("body", "").replace('\n', ' ')

            # Don't truncate
            display_str = f"{app}: {summary} - {body}"
            entries.append(display_str)
            entry_map[display_str] = notif
        dmenu_input = "\n".join(entries)

    cmd = ["walker", "--dmenu", "-p", "Notifications", "--width", "1200"]
    try:
        result = subprocess.run(
            cmd, input=dmenu_input, capture_output=True, text=True, check=False
        )
        selected = result.stdout.strip()

        if selected in entry_map and entry_map[selected]:
            notif = entry_map[selected]
            app_name = notif.get("app_name")

            if app_name:
                # Sanitize app_name for hyprctl regex and focus the window
                sanitized_name = re.escape(app_name)
                subprocess.run(
                    ["hyprctl", "dispatch", "focuswindow", f"^({sanitized_name})$"],
                    check=True
                )

    except (FileNotFoundError, subprocess.CalledProcessError) as e:
        if isinstance(e, FileNotFoundError):
            subprocess.run(["notify-send", "Error", "walker or hyprctl not found"], check=False)
        else:
            # This can happen if the window doesn't exist
            pass


if __name__ == "__main__":
    main()
