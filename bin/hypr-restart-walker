#!/bin/bash
set -euo pipefail


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    restart_services() {
      elephant service enable >/dev/null 2>&1 || true
      pkill -f "wl-paste --watch echo clipboard-changed" || true
      systemctl --user daemon-reload || true
      systemctl --user restart elephant.service || true

      if systemctl --user list-units --full -all | grep -Fq "app-walker@autostart.service"; then
        systemctl --user restart app-walker@autostart.service || true
      else
        pkill -f "walker --gapplication-service" || true
        sleep 0.2
        if command -v uwsm >/dev/null 2>&1 && [[ -n "${UWSM_ACTIVE:-}" ]]; then
          setsid uwsm app -- walker --gapplication-service >/dev/null 2>&1 &
        else
          setsid walker --gapplication-service >/dev/null 2>&1 &
        fi
      fi
    }

    if (( EUID == 0 )); then
      SCRIPT_OWNER=$(stat -c '%U' "$0")
      USER_UID=$(id -u "$SCRIPT_OWNER")
      systemd-run --uid="$SCRIPT_OWNER" --setenv=XDG_RUNTIME_DIR="/run/user/$USER_UID" \
        bash -c "$(declare -f restart_services); restart_services"
    else
      restart_services
    fi
}

main "$@"
