#!/bin/bash
set -euo pipefail

# Launch a floating terminal with the Hypr logo presentation, then execute the command passed in, and finally end with the hypr-show-done presentation.
# Used by actions such as Update System.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    cmd="$*"
    if is_uwsm_active; then
        exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.hypr.terminal --title=Hypr -e bash -c "hypr-show-logo; $cmd; if (( \$? != 130 )); then hypr-show-done; fi"
    else
        exec setsid xdg-terminal-exec --app-id=org.hypr.terminal --title=Hypr -e bash -c "hypr-show-logo; $cmd; if (( \$? != 130 )); then hypr-show-done; fi"
    fi
}

main "$@"

