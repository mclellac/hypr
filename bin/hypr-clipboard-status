#!/bin/bash
#
# Returns the number of items in the clipboard as JSON for Waybar.

set -euo pipefail
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    echo "Usage: $(basename "$0") [OPTIONS]"
    echo
    echo "Returns the number of clipboard items as JSON for Waybar."
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message and exit"
}

main() {
    check_help "$@"

    local count=0
    if command -v cliphist &>/dev/null; then
        count=$(cliphist list | wc -l || echo 0)
    fi

    local tooltip="${count} item(s) in the clipboard\n(Mid click to clear)"
    local text="󰨸"

    printf '{"text": "%s", "tooltip": "%s", "class": "clipboard", "alt": "clipboard"}\n' \
        "${text}" "${tooltip}"
}

main "$@"
