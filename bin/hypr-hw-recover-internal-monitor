#!/bin/bash
set -euo pipefail

# Clear the internal-monitor-disable toggle if no external display is connected.
# Runs before the graphical session so Hyprland doesn't block on having no output
# to render to when the user rebooted with the external unplugged.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    TOGGLE="$HOME/.local/state/hypr/toggles/hypr/internal-monitor-disable.conf"

    if [[ -f $TOGGLE ]] && ! hypr-hw-external-monitors; then
      rm -f "$TOGGLE"
    fi
}

main "$@"
