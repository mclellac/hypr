#!/bin/bash
set -euo pipefail
#
# Resets the sudo lockout for the current user. This is useful if you have
# entered your password incorrectly too many times.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

#######################################
# Main function to reset the sudo lockout.
# Globals:
#   USER - The current user's name.
# Arguments:
#   None
# Outputs:
#   None
#######################################
main() {
    check_help "$@"
    log_info "Resetting sudo lockout for user: ${USER}"
    # This command must be run as root to reset the faillock for another user.
    su -c "faillock --reset --user ${USER}"
}

main "$@"
