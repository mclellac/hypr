#!/usr/bin/env bash
#
# Sets the active theme by name and generates configurations.
# Usage: hypr-theme-set THEME_NAME

set -euo pipefail

# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

readonly USER_THEMES_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/hypr/themes"
readonly SYSTEM_THEMES_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/hypr/themes"
readonly GLOBAL_THEMES_DIR="/usr/local/share/hypr/themes"

main() {
    check_help "$@"

    local theme_name=""
    local no_reload=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-reload)
                no_reload="--no-reload"
                shift
                ;;
            *)
                if [[ -z "${theme_name}" ]]; then
                    theme_name="$1"
                else
                    log_error "Too many arguments. Usage: $(basename "$0") [--no-reload] THEME_NAME"
                    exit 1
                fi
                shift
                ;;
        esac
    done

    if [[ -z "${theme_name}" ]]; then
        log_error "Usage: $(basename "$0") [--no-reload] THEME_NAME"
        exit 1
    fi

    local theme_path=""

    if [[ -d "${USER_THEMES_DIR}/${theme_name}" ]]; then
        theme_path="${USER_THEMES_DIR}/${theme_name}"
    elif [[ -d "${SYSTEM_THEMES_DIR}/${theme_name}" ]]; then
        theme_path="${SYSTEM_THEMES_DIR}/${theme_name}"
    elif [[ -d "${GLOBAL_THEMES_DIR}/${theme_name}" ]]; then
        theme_path="${GLOBAL_THEMES_DIR}/${theme_name}"
    elif [[ -d "${theme_name}" ]]; then
        theme_path="${theme_name}"
    else
        log_error "Theme '${theme_name}' not found."
        exit 1
    fi

    log_info "Applying theme '${theme_name}'..."
    if [[ -n "${no_reload}" ]]; then
        "$(dirname "$0")/hypr-theme-templater" --no-reload "${theme_path}"
    else
        "$(dirname "$0")/hypr-theme-templater" "${theme_path}"
    fi
}

main "$@"
