#!/bin/bash
set -euo pipefail
#
# Restarts the input method handling XCompose.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

#######################################
# Main function to restart input services.
# Globals:
#   None
# Arguments:
#   None
# Outputs:
#   None
#######################################
main() {
    check_help "$@"
    # If using fcitx5, restart it
    if pgrep -x fcitx5 > /dev/null; then
        hypr-restart-app fcitx5
    fi

    # Reload hyprland input config for native compose handling
    hyprctl reload
}

main "$@"
