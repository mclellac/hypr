#!/bin/bash
set -euo pipefail

# Default temperature values

# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    ON_TEMP=$(hypr-theme-get hypr.sunset.temperature --default 4000)
    OFF_TEMP=6000

    # Ensure hyprsunset is running
    if ! pgrep -x hyprsunset; then
      if is_uwsm_active; then
        setsid uwsm-app -- hyprsunset &
      else
        setsid hyprsunset &
      fi
      sleep 1 # Give it time to register
    fi

    # Query the current temperature
    CURRENT_TEMP=$(hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+')

    restart_nightlighted_waybar() {
      if grep -q "custom/nightlight" ~/.config/waybar/config.jsonc; then
        hypr-restart-waybar # restart waybar in case user has waybar module for hyprsunset
      fi
    }

    if [[ "$CURRENT_TEMP" == "$OFF_TEMP" ]]; then
      hyprctl hyprsunset temperature "$ON_TEMP"
      notify-send -u low "  Nightlight screen temperature"
      restart_nightlighted_waybar
    else
      hyprctl hyprsunset temperature "$OFF_TEMP"
      notify-send -u low "   Daylight screen temperature"
      restart_nightlighted_waybar
    fi
}

main "$@"
