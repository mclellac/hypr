#!/bin/bash
#
# Displays an interactive dmenu/walker file picker menu.

set -euo pipefail

_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    echo "Usage: $(basename "$0") TITLE SEARCH_PATH EXTENSIONS"
}

main() {
    check_help "$@"

    local title="${1:-Select file}"
    local search_path="${2:-$HOME}"
    local extensions="${3:-*}"

    if [[ ! -d "${search_path}" ]]; then
        search_path="$HOME"
    fi

    local find_args=("-type" "f")
    if [[ "${extensions}" != "*" ]]; then
        log_info "Filtering by extensions: ${extensions}"
    fi

    local selected=""
    if command -v walker &>/dev/null; then
        selected=$(find "${search_path}" "${find_args[@]}" 2>/dev/null | walker --dmenu -p "${title}" || true)
    elif command -v rofi &>/dev/null; then
        selected=$(find "${search_path}" "${find_args[@]}" 2>/dev/null | rofi -dmenu -p "${title}" || true)
    else
        selected=$(find "${search_path}" "${find_args[@]}" 2>/dev/null | head -n 1 || true)
    fi

    if [[ -n "${selected}" ]]; then
        echo "${selected}"
        exit 0
    fi

    exit 1
}

main "$@"
