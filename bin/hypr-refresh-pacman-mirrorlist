#!/bin/bash
#
# Refreshes the pacman mirrorlist with the default version from the repo.

set -euo pipefail

# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    local default_mirrorlist="${HYPR_PATH}/default/pacman/mirrorlist"
    local system_mirrorlist="/etc/pacman.d/mirrorlist"

    if [[ -f "${default_mirrorlist}" ]]; then
        log_info "Refreshing pacman mirrorlist..."
        sudo cp -f "${default_mirrorlist}" "${system_mirrorlist}"
    else
        log_error "Default mirrorlist not found at ${default_mirrorlist}"
        exit 1
    fi
}

main "$@"
