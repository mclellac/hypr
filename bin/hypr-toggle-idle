#!/bin/bash
set -euo pipefail


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    if pgrep -x hypridle >/dev/null; then
      pkill -x hypridle
      notify-send -u low "󱫖    Stop locking computer when idle"
    else
      if is_uwsm_active; then
        uwsm-app -- hypridle >/dev/null 2>&1 &
      else
        hypridle >/dev/null 2>&1 &
      fi
      notify-send -u low "󱫖    Now locking computer when idle"
    fi

    pkill -RTMIN+9 waybar
}

main "$@"
