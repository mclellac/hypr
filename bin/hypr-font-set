#!/bin/bash
#
# Sets the active environment font family.

set -euo pipefail

_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    echo "Usage: $(basename "$0") FONT_FAMILY"
    echo
    echo "Sets the active system font family."
}

main() {
    check_help "$@"

    if [[ $# -lt 1 ]]; then
        log_error "Missing font family argument."
        usage >&2
        exit 1
    fi

    local font_family="$1"
    log_info "Setting environment font family to: ${font_family}"

    local templater_bin
    templater_bin="$(dirname "$0")/hypr-theme-templater"
    if [[ -x "${templater_bin}" ]]; then
        "${templater_bin}"
    fi
}

main "$@"
