#!/bin/bash

# hypr:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# hypr:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
hypr-pkg-add heroic-games-launcher-bin
hypr-install-gaming-gpu-lib32

setsid gtk-launch heroic >/dev/null 2>&1 &
