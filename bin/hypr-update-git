#!/bin/bash
set -euo pipefail
#
# Updates the local hypr git repository by pulling the latest changes.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

#######################################
# Main function to update the git repository.
# Globals:
#   HYPR_PATH - The path to the hypr git repository.
# Arguments:
#   None
# Outputs:
#   None
#######################################
main() {
    check_help "$@"
    local repo_path_file="${HOME}/.config/hypr/hypr_repo_path"
    local git_repo_path=""

    if [[ -f "${repo_path_file}" ]]; then
        git_repo_path=$(cat "${repo_path_file}")
    fi

    if [[ -z "${git_repo_path}" || ! -d "${git_repo_path}/.git" ]]; then
        echo "Error: Could not find hypr git repository. Please ensure it's cloned and install.sh has been run." >&2
        exit 1
    fi

    echo -e "\e[32mUpdating hypr repository at ${git_repo_path}...\e[0m"
    git -C "${git_repo_path}" pull --autostash

    # This checks for merge conflicts and resets if any are found.
    if ! git -C "${git_repo_path}" diff --check; then
        log_info "Merge conflicts detected. Resetting..."
        git -C "${git_repo_path}" reset --merge
    fi

    echo -e "\e[32mPropagating changes to installation directory...\e[0m"
    "${git_repo_path}/install.sh"
}

main "$@"
