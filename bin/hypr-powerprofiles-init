#!/bin/bash
set -euo pipefail

# Set the correct power profile on boot based on current AC/battery state.
# The udev rules only fire on state *changes*, so without this, booting
# on AC leaves you in the default balanced mode.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    if hypr-battery-present && ! hypr-ac-present; then
      hypr-powerprofiles-set battery
    else
      hypr-powerprofiles-set ac
    fi
}

main "$@"
