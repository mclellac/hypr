#!/bin/bash
set -euo pipefail

# Allow unprivileged access to the Framework 16 keyboard for RGB control via qmk_hid.

if hypr-hw-framework16; then
  if [[ ! -f /etc/udev/rules.d/50-framework16-qmk-hid.rules ]]; then
    log_info "Installing Framework 16 QMK HID udev rules..."
    hypr-refresh-config framework16-qmk-hid.rules
    sudo cp ~/.config/framework16-qmk-hid.rules /etc/udev/rules.d/50-framework16-qmk-hid.rules
    sudo udevadm control --reload-rules
    sudo udevadm trigger
  fi
fi
