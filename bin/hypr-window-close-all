#!/bin/bash
#
# Closes all open windows (alias/wrapper for hypr-cmd-close-all-windows).

set -euo pipefail

_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    echo "Usage: $(basename "$0")"
    echo
    echo "Closes all open windows across workspaces."
}

main() {
    check_help "$@"
    exec "$(dirname "$0")/hypr-cmd-close-all-windows" "$@"
}

main "$@"
