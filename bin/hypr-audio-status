#!/bin/bash
#
# Returns audio status (volume and mute) as JSON for Waybar.

set -euo pipefail
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

usage() {
    echo "Usage: $(basename "$0") [OPTIONS]"
    echo
    echo "Returns audio status (volume and mute) as JSON for Waybar."
    echo
    echo "Options:"
    echo "  -h, --help    Show this help message and exit"
}

main() {
    check_help "$@"

    if ! command -v pamixer &>/dev/null; then
        echo '{"text": "err", "tooltip": "pamixer not found", "class": "error", "percentage": 0}'
        return
    fi

    local muted
    muted=$(pamixer --get-mute)

    local volume
    volume=$(pamixer --get-volume || echo 0)

    local tooltip="Volume: ${volume}%"
    local css_class=""
    local text=""

    if [[ "${muted}" == "true" ]] || [[ ${volume} -eq 0 ]]; then
        css_class="muted"
        text="󰝟"
        tooltip+=" (Muted)"
    else
        if [[ ${volume} -le 25 ]]; then
            css_class="vol-25"
            text=""
        elif [[ ${volume} -le 50 ]]; then
            css_class="vol-50"
            text=""
        elif [[ ${volume} -le 75 ]]; then
            css_class="vol-75"
            text=""
        else
            css_class="vol-100"
            text=""
        fi
    fi

    printf '{"text": "%s", "tooltip": "%s", "class": "%s", "percentage": %d}\n' \
        "${text}" "${tooltip}" "${css_class}" "${volume}"
}

main "$@"
