#!/bin/bash
set -euo pipefail

# Launch or focus on a given command identified by the passed in window-pattern.
# Use by some default bindings, like the one for Spotify, to ensure there is only one instance of the application open.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    if (($# == 0)); then
      log_info "Usage: hypr-launch-or-focus [window-pattern] [launch-command]"
      exit 1
    fi

    WINDOW_PATTERN="$1"
    LAUNCH_COMMAND="${2:-"uwsm-app -- $WINDOW_PATTERN"}"
    WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg p "$WINDOW_PATTERN" '.[]|select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.address' | head -n1)

    if [[ -n $WINDOW_ADDRESS ]]; then
      hyprctl eval "hl.dsp.focus({ window = \"address:$WINDOW_ADDRESS\" })"
    else
      eval exec setsid "$LAUNCH_COMMAND"
    fi
}

main "$@"
