#!/bin/bash
#
# Clears the screen and displays the 'hypr' logo from a text file.

set -euo pipefail

# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    local logo_file="${HYPR_PATH}/logo.txt"
    if [[ -f "${logo_file}" ]]; then
        clear
        echo -e "\033[32m" # Green text
        cat "${logo_file}"
        echo -e "\033[0m"  # Reset color
        echo
    else
        log_error "Logo file not found: ${logo_file}"
        exit 1
    fi
}

main "$@"
