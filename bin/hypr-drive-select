#!/bin/bash
set -euo pipefail

# Select a drive from a list with info that includes space and brand. Used by hypr-drive-set-password.


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    if (($# == 0)); then
      drives=$(lsblk -dpno NAME | grep -E '/dev/(sd|hd|vd|nvme|mmcblk|xv)')
    else
      drives="$*"
    fi

    drives_with_info=""
    while IFS= read -r drive; do
      [[ -n $drive ]] || continue
      drives_with_info+="$(hypr-drive-info "$drive")"$'\n'
    done <<<"$drives"

    selected_drive="$(printf "%s" "$drives_with_info" | gum choose --header "Select drive")" || exit 1
    printf "%s\n" "$selected_drive" | awk '{print $1}'
}

main "$@"
