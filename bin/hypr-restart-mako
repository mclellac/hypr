#!/bin/bash
set -euo pipefail

# Reload mako configuration (used by the Hypr theme switching).


# Source utility functions
# Resolve script directory (handles PATH lookup and direct execution)
_SCRIPT_DIR="$(dirname "$0")"
if [ ! -f "$_SCRIPT_DIR/hypr-utils" ]; then
    _SCRIPT_DIR="$(dirname "$(command -v "$0" 2>/dev/null || echo "$0")")"
fi
source "$_SCRIPT_DIR/hypr-utils"

main() {
    check_help "$@"

    if pgrep -x mako >/dev/null; then
        log_info "Reloading mako..."
        makoctl reload
    else
        log_info "Starting mako..."
        if is_uwsm_active; then
            hyprctl dispatch 'hl.dsp.exec_cmd("uwsm app -- mako")'
        else
            hyprctl dispatch 'hl.dsp.exec_cmd("mako")'
        fi
    fi
}

main "$@"
